---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import TopicHubs from '../../components/TopicHubs.astro';
import { guideArticles, getGuideBySlug } from '../../data/guides';

export function getStaticPaths() {
  return guideArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const SITE = 'https://testpreppilot.com';
const canonicalUrl = new URL(`/guides/${article.slug}`, Astro.site || SITE).toString();
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Guides', href: '/guides' },
  { label: article.title, href: `/guides/${article.slug}` },
];

// ── Article schema (GEO step 3) ────────────────────────────────────────
// Same citable wrapper the exam pages use: who wrote it, when it was
// checked, and the canonical URL. Editorial Board is the site-wide author
// entity (BaseLayout emits its node on every page).
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonicalUrl}#article`,
  headline: article.title,
  description: article.description,
  url: canonicalUrl,
  mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
  inLanguage: 'en-US',
  author: { '@id': `${SITE}/#editorial-board` },
  publisher: { '@id': `${SITE}/#organization` },
  datePublished: article.dateISO,
  dateModified: article.dateISO,
  about: {
    '@type': 'Thing',
    name: article.category,
  },
  isAccessibleForFree: true,
};

// ── FAQ schema (GEO rules 2.5 + 3) ─────────────────────────────────────
// Generated from the same array the template renders below, so the
// structured data cannot disagree with the visible text.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonicalUrl}#faq`,
  mainEntity: article.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={`${article.title} — TestPrepPilot Guides`}
  description={article.description}
  canonical={canonicalUrl}
  ogType="article"
  articlePublishedTime={article.dateISO}
  articleModifiedTime={article.dateISO}
>
  {/* BreadcrumbNav emits the page's single BreadcrumbList JSON-LD itself. */}
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="container">
    <BreadcrumbNav items={breadcrumbItems} />

    <header class="article-hero">
      <p class="eyebrow">{article.category}</p>
      <h1>{article.title}</h1>
      <p class="lede">{article.intro}</p>
      <div class="article-meta">
        <span>Updated {article.dateDisplay}</span>
        <span class="dot" aria-hidden="true">•</span>
        <span>{article.readTime}</span>
      </div>
    </header>

    <main class="article-body">
      {article.sections.map((section) => (
        <section class="article-section">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((p) => <p>{p}</p>)}
          {section.list && (
            <ul class="article-list">
              {section.list.map((item) => (
                <li>
                  <strong>{item.title}.</strong> {item.text}
                </li>
              ))}
            </ul>
          )}
          {section.callout && <p class="callout">{section.callout}</p>}
        </section>
      ))}

      {/* GEO rule 2.5: FAQ at the bottom, one concrete question per entry.
          The FAQPage JSON-LD above is generated from this same array. */}
      <section class="article-faq" id="faq">
        <h2>Frequently asked questions</h2>
        <div class="faq-list">
          {article.faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <aside class="related-panel">
        <h3>Keep reading</h3>
        <ul>
          {article.related.map((r) => (
            <li><a href={r.href}>{r.label} &rarr;</a></li>
          ))}
        </ul>
        <a href="/guides" class="back-link">All guides &rarr;</a>
      </aside>
    </main>
  </div>

  <TopicHubs />
</BaseLayout>

<style>
  .container { max-width: 820px; margin: 0 auto; padding: 0 2rem; }

  /* Hero */
  .article-hero { padding: 4rem 0 2.5rem; border-bottom: 2px solid var(--ink); margin-bottom: 3rem; }
  .article-hero .eyebrow { font-family: var(--font-mono); color: var(--primary); letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.8rem; margin: 0 0 1.25rem; font-weight: 700; }
  .article-hero h1 { font-family: var(--font-heading); font-size: var(--fs-h1); line-height: 1.12; margin: 0 0 1.5rem; color: var(--ink); }
  .article-hero .lede { font-family: var(--font-body); font-size: var(--fs-prose); color: var(--muted); line-height: 1.75; margin: 0 0 1.5rem; }
  .article-meta { display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-mono); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .article-meta .dot { opacity: 0.6; }

  /* Body */
  .article-body { padding-bottom: 6rem; }
  .article-section { margin-bottom: 2.75rem; scroll-margin-top: 6rem; }
  .article-section h2 { font-family: var(--font-heading); font-size: var(--fs-h2); margin: 0 0 1.1rem; line-height: 1.2; color: var(--ink); }
  .article-section p { font-family: var(--font-body); font-size: var(--fs-prose); line-height: 1.8; margin: 0 0 1.35rem; color: var(--ink); }

  .article-list { padding-left: 1.25rem; margin: 0 0 1.35rem; }
  .article-list li { font-family: var(--font-body); font-size: var(--fs-prose); line-height: 1.7; margin-bottom: 0.85rem; color: var(--ink); }
  .article-list strong { color: var(--ink); }

  .callout {
    background: var(--cream);
    border-left: 4px solid var(--primary);
    border-radius: var(--radius);
    padding: 1.1rem 1.4rem;
    font-size: 1.05rem !important;
    color: var(--muted) !important;
    font-style: italic;
  }

  /* FAQ — same visual language as the category-page FAQ */
  .article-faq { margin-top: 1.5rem; padding-top: 2rem; border-top: 1px solid var(--line); scroll-margin-top: 6rem; }
  .article-faq h2 { font-family: var(--font-heading); font-size: var(--fs-h2); margin: 0 0 1.25rem; line-height: 1.2; color: var(--ink); }
  .faq-list { display: flex; flex-direction: column; gap: 0.65rem; }
  .faq-item { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem 1.35rem; }
  .faq-item summary { cursor: pointer; font-weight: 600; font-family: var(--font-heading); font-size: 1.05rem; color: var(--ink); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; float: right; color: var(--primary); font-weight: 700; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { color: var(--muted); line-height: 1.75; margin: 0.85rem 0 0; font-size: var(--fs-prose); }

  /* Related */
  .related-panel {
    margin-top: 1rem;
    padding: 1.75rem 2rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .related-panel h3 { font-family: var(--font-heading); font-size: var(--fs-h3); margin: 0 0 1rem; color: var(--ink); }
  .related-panel ul { list-style: none; margin: 0 0 1.25rem; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .related-panel a { color: var(--primary); font-weight: 600; text-decoration: none; font-family: var(--font-body); font-size: 1.02rem; }
  .related-panel a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .back-link { display: inline-block; font-family: var(--font-mono); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); text-decoration: none; }
  .back-link:hover { color: var(--ink); }

  @media (max-width: 640px) {
    .article-hero { padding: 3rem 0 2rem; }
  }
</style>
