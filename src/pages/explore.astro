---
import BaseLayout from '../layouts/BaseLayout.astro';
import { credentials } from '../data/credentials';
import { categories } from '../data/categories';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import SearchUI from '../components/SearchUI.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Explore', href: '/explore' }
];

const categoriesWithCredentials = categories.map(cat => ({
  ...cat,
  credentials: credentials.filter(c => c.category === cat.id)
})).filter(cat => cat.credentials.length > 0);

const canonicalUrl = new URL('/explore', Astro.site || 'https://testpreppilot.com').toString();
---

<BaseLayout 
  title="Explore Credentials Directory — TestPrepPilot" 
  description="Browse our comprehensive directory of professional credentials, certifications, and licenses."
  canonical={canonicalUrl}
>
  <div class="container | animate-on-scroll">
    <BreadcrumbNav items={breadcrumbItems} />
    
    <header class="explore-hero">
      <p class="eyebrow">CREDENTIAL DIRECTORY</p>
      <h1>Find the path that <em>fits your future.</em></h1>
      <p class="lede">Browse our curated database of verified professional certifications and state licenses.</p>
    </header>

    <div class="directory-layout">
      <aside class="filter-sidebar">
        <nav class="filter-nav" id="scroll-spy-nav">
          {categoriesWithCredentials.map((cat, idx) => (
            <a href={`#${cat.id}`} class={`spy-link ${idx === 0 ? 'active' : ''}`} data-target={cat.id}>
              {cat.name}
            </a>
          ))}
        </nav>
      </aside>

      <main class="directory-main">
        <div class="search-bar">
          <SearchUI />
        </div>

        <div class="category-sections">
          {categoriesWithCredentials.map(cat => (
            <section id={cat.id} class="category-section scroll-spy-section">
              <div class="section-header">
                <h2>{cat.name}</h2>
                <p>{cat.description}</p>
              </div>
              
              <ul class="directory-list" id={`list-${cat.id}`}>
                {cat.credentials.map(cred => (
                  <li class="directory-item" data-name={cred.name.toLowerCase()} data-category={cred.category.toLowerCase()} data-tagline={cred.tagline?.toLowerCase() || ''}>
                    <a href={`/paths/${cred.slug}`} class="item-link">
                      <div class="item-content">
                        <h3 class="item-title">{cred.name}</h3>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const sections = document.querySelectorAll('.scroll-spy-section');
    const navLinks = document.querySelectorAll('.spy-link');

    if (!sections.length || !navLinks.length) return;

    // Smooth scroll for nav links
    navLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('href').substring(1);
        const targetSection = document.getElementById(targetId);
        if (targetSection) {
          targetSection.scrollIntoView({ behavior: 'smooth' });
          history.pushState(null, null, `#${targetId}`);
        }
      });
    });

    const observerOptions = {
      root: null,
      rootMargin: '-100px 0px -60% 0px',
      threshold: 0
    };

    const observerCallback = (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const currentId = entry.target.getAttribute('id');
          navLinks.forEach(link => {
            link.classList.remove('active');
            if (link.getAttribute('data-target') === currentId) {
              link.classList.add('active');
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(observerCallback, observerOptions);
    sections.forEach(section => observer.observe(section));

    // Handle initial hash on load
    if (window.location.hash) {
      const id = window.location.hash.substring(1);
      const target = document.getElementById(id);
      if (target) {
        setTimeout(() => target.scrollIntoView({ behavior: 'smooth' }), 100);
      }
    }
  });
</script>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
  
  /* Hero Section */
  .explore-hero { margin-top: -1rem; padding: 0 0 1rem 0; border-bottom: 1px solid var(--line); margin-bottom: 1rem; }
  .explore-hero .eyebrow { font-family: var(--font-mono); color: var(--primary); letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.75rem; margin-bottom: 0.25rem; font-weight: 700; }
  .explore-hero h1 { font-family: var(--font-heading); font-size: clamp(2rem, 3.5vw, 3.5rem); margin: 0 0 0.25rem; font-weight: 700; line-height: 1.1; }
  .explore-hero .lede { font-family: var(--font-body); font-size: 1.1rem; color: var(--muted); max-width: 750px; line-height: 1.5; margin: 0; }
  
  /* Layout */
  .directory-layout { display: grid; grid-template-columns: 240px 1fr; gap: 2rem; padding-bottom: 4rem; }
  
  /* Sidebar Nav */
  .filter-sidebar { position: relative; }
  .filter-nav { display: flex; flex-direction: column; gap: 0.25rem; position: sticky; top: 120px; border-right: 1px solid var(--line); padding-right: 1.5rem; }
  .filter-nav a { padding: 0.75rem 1rem; border-right: 2px solid transparent; margin-right: -1.5rem; color: var(--muted); text-decoration: none; transition: all var(--transition); font-family: var(--font-body); font-size: 1.05rem; }
  .filter-nav a:hover { color: var(--ink); }
  .filter-nav a.active { border-right-color: var(--primary); color: var(--ink); font-weight: 700; font-family: var(--font-heading); font-size: 1.25rem; }
  
  /* Main Content */
  .search-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0; gap: 1rem; flex-wrap: wrap; }
  .search-bar input { flex: 1; min-width: 250px; padding: 0.65rem 1rem; border: 1px solid var(--line); border-radius: var(--radius); font-family: var(--font-body); font-size: 1rem; transition: border-color var(--transition); background: var(--paper); color: var(--ink); }
  .search-bar input:focus { outline: none; border-color: var(--primary); }
  
  /* Sections */
  .category-sections { display: flex; flex-direction: column; gap: 1rem; }
  .category-section { scroll-margin-top: 60px; }
  .section-header { margin-bottom: 0.5rem; padding-bottom: 0.25rem; border-bottom: 1px solid var(--line); }
  .section-header h2 { font-family: var(--font-heading); font-size: 1.4rem; margin: 0 0 0.15rem 0; color: var(--ink); font-weight: 600; line-height: 1.2; }
  .section-header p { font-family: var(--font-body); font-size: 0.85rem; color: var(--muted); margin: 0; line-height: 1.4; }
  
  /* Directory Grid (Strict 3 Columns) */
  .directory-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  
  /* Credential Card */
  .directory-item { display: flex; }
  .item-link { display: flex; flex-direction: column; width: 100%; padding: 1rem 1.25rem; background: var(--paper); border: 1px solid var(--line); text-decoration: none; color: var(--ink); transition: all var(--transition); border-radius: var(--radius); position: relative; overflow: hidden; }
  
  .item-link::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--primary); transform: scaleX(0); transform-origin: left; transition: transform var(--transition); }
  
  .item-link:hover { border-color: transparent; box-shadow: var(--shadow-hover); transform: translateY(-3px); text-decoration: none; }
  .item-link:hover::before { transform: scaleX(1); }
  
  .item-title { font-size: 1.15rem; margin: 0; font-family: var(--font-body); font-weight: 600; line-height: 1.3; text-rendering: optimizeLegibility; }
  
  /* Removed item-dot and item-arrow from original DOM to simplify elegant design */
  .item-dot, .item-arrow { display: none; }
  
  .empty-state { grid-column: 1 / -1; padding: 4rem; text-align: center; background: var(--cream); border-radius: var(--radius); border: 1px solid var(--line); }
  .empty-state p { font-size: 1.25rem; font-family: var(--font-heading); color: var(--ink); margin-bottom: 1.5rem; }
  
  @media (max-width: 900px) {
    .directory-layout { grid-template-columns: 1fr; gap: 2rem; }
    .filter-nav { flex-direction: row; flex-wrap: wrap; position: static; border-right: none; padding-right: 0; border-bottom: 1px solid var(--line); padding-bottom: 1rem; }
    .filter-nav a { border-right: none; border-bottom: 2px solid transparent; margin-right: 0; margin-bottom: -1rem; padding: 0.5rem 1rem; }
    .filter-nav a.active { border-right-color: transparent; border-bottom-color: var(--primary); }
    .page-hero { padding: 3rem 0; margin-bottom: 2rem; }
    .directory-list { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  }
</style>
