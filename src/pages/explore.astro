---
import BaseLayout from '../layouts/BaseLayout.astro';
import { credentials } from '../data/credentials';
import { categories } from '../data/categories';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import SearchUI from '../components/SearchUI.astro';
const categoryParam = Astro.url.searchParams.get('category');
const filteredCredentials = categoryParam 
  ? credentials.filter(c => c.category === categoryParam)
  : credentials;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Explore', href: '/explore' }
];
---

<BaseLayout 
  title="Explore Credentials Directory — TestPrepPilot" 
  description="Browse our comprehensive directory of professional credentials, certifications, and licenses."
>
  <div class="container | animate-on-scroll">
    <BreadcrumbNav items={breadcrumbItems} />
    
    <header class="page-hero">
      <p class="eyebrow">CREDENTIAL DIRECTORY</p>
      <h1>Find the path that <em>fits your future.</em></h1>
      <p class="lede">Browse our curated database of verified professional certifications and state licenses.</p>
    </header>

    <div class="directory-layout">
      <aside class="filter-sidebar">
        <nav class="filter-nav">
          <a href="/explore" class={!categoryParam ? 'active' : ''}>All paths</a>
          {categories.map(cat => (
            <a href={`/explore?category=${cat.id}`} class={categoryParam === cat.id ? 'active' : ''}>
              {cat.name}
            </a>
          ))}
        </nav>
      </aside>

      <main class="directory-main">
        <div class="search-bar">
          <SearchUI />
        </div>

        <ul class="directory-list" id="directory-list">
          {filteredCredentials.length > 0 ? (
            filteredCredentials.map(cred => (
              <li class="directory-item" data-name={cred.name.toLowerCase()} data-category={cred.category.toLowerCase()} data-tagline={cred.tagline?.toLowerCase() || ''}>
                <a href={`/paths/${cred.slug}`} class="item-link">
                  <div class="item-dot"></div>
                  <div class="item-content">
                    <div class="item-meta">
                      <span class="item-category">{cred.category}</span>
                      <span class="item-type">{cred.type}</span>
                    </div>
                    <h2 class="item-title">{cred.name}</h2>
                    <p class="item-tagline">{cred.tagline}</p>
                    <div class="item-details">
                      {cred.time && <span><i class="icon-clock"></i> {cred.time}</span>}
                      {cred.cost && <span><i class="icon-wallet"></i> {cred.cost}</span>}
                    </div>
                  </div>
                  <div class="item-arrow">&rarr;</div>
                </a>
              </li>
            ))
          ) : (
            <li class="empty-state">
              <p>No credentials found for this category.</p>
              <a href="/explore" class="btn btn-outline">Clear filters</a>
            </li>
          )}
        </ul>
      </main>
    </div>
  </div>
</BaseLayout>



<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
  .page-hero { padding: 4rem 0; border-bottom: 1px solid var(--ink); margin-bottom: 2rem; }
  .page-hero h1 { font-size: 3.5rem; margin: 1rem 0; }
  .page-hero .lede { font-size: 1.25rem; max-width: 700px; }
  
  .directory-layout { display: grid; grid-template-columns: 250px 1fr; gap: 3rem; }
  
  .filter-nav { display: flex; flex-direction: column; gap: 0.5rem; position: sticky; top: 2rem; }
  .filter-nav a { padding: 0.5rem 1rem; border-left: 2px solid transparent; color: var(--ink); text-decoration: none; transition: all 0.2s; }
  .filter-nav a:hover, .filter-nav a.active { border-left-color: var(--primary); font-weight: bold; background: var(--cream); }
  
  .search-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; gap: 1rem; flex-wrap: wrap; }
  .search-bar input { flex: 1; min-width: 250px; padding: 0.75rem 1rem; border: 1px solid var(--ink); border-radius: 4px; font-family: var(--font-body); }
  .result-count { font-family: var(--font-mono); font-size: 0.875rem; color: #666; }
  
  .directory-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .directory-item .item-link { display: grid; grid-template-columns: auto 1fr auto; gap: 1.5rem; align-items: center; padding: 1.5rem; background: var(--paper); border: 1px solid #ddd; text-decoration: none; color: var(--ink); transition: all 0.2s ease; border-radius: 4px; }
  .directory-item .item-link:hover { border-color: var(--ink); box-shadow: 4px 4px 0 var(--ink); transform: translate(-2px, -2px); }
  
  .item-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--primary); }
  .item-meta { display: flex; gap: 1rem; font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.5rem; color: #666; }
  .item-title { font-size: 1.25rem; margin: 0 0 0.5rem 0; font-family: var(--font-serif); }
  .item-tagline { margin: 0 0 1rem 0; font-size: 0.9rem; }
  .item-details { display: flex; gap: 1.5rem; font-family: var(--font-mono); font-size: 0.8rem; color: #555; }
  .item-arrow { font-size: 1.5rem; opacity: 0; transition: opacity 0.2s, transform 0.2s; }
  .directory-item .item-link:hover .item-arrow { opacity: 1; transform: translateX(5px); }
  
  .empty-state { padding: 3rem; text-align: center; background: var(--cream); border-radius: 4px; }
  
  @media (max-width: 768px) {
    .directory-layout { grid-template-columns: 1fr; }
    .filter-nav { flex-direction: row; flex-wrap: wrap; position: static; }
    .filter-nav a { border-left: none; border-bottom: 2px solid transparent; }
    .filter-nav a:hover, .filter-nav a.active { border-left-color: transparent; border-bottom-color: var(--primary); }
  }
</style>
