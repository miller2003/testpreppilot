---
import BaseLayout from '../layouts/BaseLayout.astro';
import StateDirectory from '../components/StateDirectory.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'States', href: '/states' }
];
---

<BaseLayout
  title="Professional Licenses & Certifications by State — TestPrepPilot"
  description="Browse verified professional license and certification requirements for all 50 U.S. states and Washington, D.C. Find state-specific rules, boards, and pathways."
  canonical="https://testpreppilot.com/states"
  ogImage="/og-state.png"
>
  <div class="container animate-on-scroll">
    <BreadcrumbNav items={breadcrumbItems} />

    <header class="states-hero">
      <p class="eyebrow">LICENSING, STATE BY STATE</p>
      <h1>Requirements, by state</h1>
      <p class="lede">
        Every state sets its own rules, boards, and reciprocity agreements. Pick a state to see its
        verified professional credential pathways.
      </p>
    </header>

    <StateDirectory heading="All 50 states &amp; D.C." />
  </div>
</BaseLayout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
  .states-hero { padding: 3rem 0 3.5rem; border-bottom: 1px solid var(--line); margin-bottom: 3rem; }
  .states-hero .eyebrow { font-family: var(--font-mono); color: var(--primary); letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.75rem; margin: 0 0 1rem; font-weight: 700; }
  .states-hero h1 { font-family: var(--font-heading); font-size: clamp(2.6rem, 5vw, 3.8rem); margin: 0 0 1.25rem; line-height: 1.1; }
  .states-hero .lede { font-size: 1.2rem; color: var(--muted); max-width: 720px; line-height: 1.7; margin: 0; }
</style>
