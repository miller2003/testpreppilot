---
import BaseLayout from '../layouts/BaseLayout.astro';

// The standalone /exams listing has been retired: the homepage IS now the
// directory. Keep this as a meta-refresh + canonical fallback for any host that
// does not apply the server 301 in public/_redirects / vercel.json.
const target = 'https://testpreppilot.com/';
---
<BaseLayout
  title="Exam Directory — TestPrepPilot"
  description="The TestPrepPilot exam directory now lives on the homepage — every U.S. exam, license and certification, searchable in one clean directory."
  canonical={target}
>
  <meta http-equiv="refresh" content="0; url=/" />
  <div class="container" style="max-width:760px;margin:0 auto;padding:6rem 2rem;text-align:center;">
    <h1 style="font-family:var(--font-heading);font-size:2rem;margin-bottom:1rem;">The directory has moved home</h1>
    <p style="color:var(--muted);margin-bottom:1.5rem;">
      Every exam, license and certification is now browsable and searchable right on the
      <a href="/">TestPrepPilot homepage</a>.
    </p>
    <a href="/" class="button">Go to the directory</a>
  </div>
</BaseLayout>

<script is:inline>
  window.location.replace('/');
</script>
