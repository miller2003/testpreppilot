---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import TopicHubs from '../components/TopicHubs.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Reviews', href: '/reviews' }
];

const reviews = [
  {
    quote: "TestPrepPilot completely removed the anxiety of figuring out the Texas Real Estate requirements. Their roadmap was the only reason I passed on my first try.",
    author: "Sarah Jenkins",
    role: "Passed Texas Real Estate Exam"
  },
  {
    quote: "The side-by-side provider comparisons are brilliant. I avoided spending $800 on a course that wouldn't have fit my schedule anyway. Ended up passing my Enrolled Agent exam in 3 months.",
    author: "David Chen",
    role: "Passed Enrolled Agent Exam"
  },
  {
    quote: "I've been in the trades for 10 years, but the paperwork for my contractor license was terrifying. The checklist here broke it down so simply. I cannot recommend this platform enough.",
    author: "Michael T.",
    role: "Passed HVAC Journeyman Exam"
  },
  {
    quote: "It's rare to find a site that isn't just trying to sell you something. The independent research here is obvious. Clean, direct, and incredibly useful.",
    author: "Emily R.",
    role: "Passed CPA FAR Section"
  },
  {
    quote: "I was overwhelmed by the differing state requirements for medical assisting. The guide here made everything crystal clear. I felt completely prepared.",
    author: "Jessica M.",
    role: "Passed CMA Exam"
  },
  {
    quote: "As someone pivoting careers, I needed a no-nonsense guide to IT certifications. The roadmap saved me hundreds of hours of googling.",
    author: "James L.",
    role: "Passed CompTIA A+"
  }
];
---

<BaseLayout 
  title="Reviews & Testimonials — TestPrepPilot"
  description="See how TestPrepPilot's independent roadmaps have helped professionals pass their exams and advance their careers."
>
  <div class="container">
    <BreadcrumbNav items={breadcrumbItems} />
    
    <header class="editorial-hero">
      <p class="eyebrow">COMMUNITY REVIEWS</p>
      <h1>Trusted by those who <em>take the next step.</em></h1>
      <p class="lede">Read what real professionals have to say about our independently researched certification roadmaps.</p>
    </header>

    <main class="reviews-grid">
      {reviews.map(review => (
        <div class="review-card">
          <div class="quote-mark">"</div>
          <p class="quote-text">{review.quote}</p>
          <div class="author-meta">
            <span class="author-name">{review.author}</span>
            <span class="author-role">{review.role}</span>
          </div>
        </div>
      ))}
    </main>
  </div>

  <TopicHubs />
</BaseLayout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
  
  /* Hero Section */
  .editorial-hero { padding: 5rem 0 4rem; border-bottom: 1px solid var(--line); margin-bottom: 4.5rem; text-align: center; }
  .editorial-hero .eyebrow { font-family: var(--font-mono); color: var(--primary); letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.85rem; margin-bottom: 1.5rem; font-weight: 700; }
  .editorial-hero h1 { font-family: var(--font-heading); font-size: clamp(3rem, 5vw, 4.5rem); margin: 0 0 1.5rem; font-weight: 700; line-height: 1.1; color: var(--ink); }
  .editorial-hero .lede { font-family: var(--font-body); font-size: 1.35rem; color: var(--muted); max-width: 750px; margin: 0 auto; line-height: 1.7; }
  
  /* Masonry-style Grid */
  .reviews-grid { 
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 3rem;
    padding-bottom: 8rem;
  }
  
  .review-card {
    background: var(--paper);
    padding: 3rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform var(--transition), box-shadow var(--transition);
  }
  
  .review-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-sm);
  }
  
  .quote-mark {
    font-family: var(--font-heading);
    font-size: 8rem;
    color: var(--primary);
    opacity: 0.15;
    position: absolute;
    top: -1rem;
    left: 1.5rem;
    line-height: 1;
    pointer-events: none;
  }
  
  .quote-text {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    line-height: 1.4;
    color: var(--ink);
    margin: 0 0 2.5rem 0;
    position: relative;
    z-index: 1;
    font-style: italic;
  }
  
  .author-meta {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  
  .author-name {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--ink);
    font-size: 1.1rem;
  }
  
  .author-role {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
