---
import BaseLayout from '../layouts/BaseLayout.astro';

// Reviews content has been consolidated into the /about E-E-A-T hub.
// Keep the URL alive (external links, bookmarks) and forward to /about.
const target = 'https://testpreppilot.com/about';
---
<BaseLayout
  title="Reviews — TestPrepPilot"
  description="Reader reviews of TestPrepPilot's independently researched exam roadmaps now live on our About page."
  canonical={target}
>
  <meta http-equiv="refresh" content="0; url=/about#reviews" />
  <div class="container" style="max-width:760px;margin:0 auto;padding:6rem 2rem;text-align:center;">
    <h1 style="font-family:var(--font-heading);font-size:2rem;margin-bottom:1rem;">Reviews have moved</h1>
    <p style="color:var(--muted);margin-bottom:1.5rem;">
      Reader testimonials are now part of our <a href="/about#reviews">About the desk</a> page.
    </p>
    <a href="/about#reviews" class="button">Continue to About</a>
  </div>
</BaseLayout>

<script is:inline>
  window.location.replace('/about#reviews');
</script>
