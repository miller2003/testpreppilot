---
import BaseLayout from '../layouts/BaseLayout.astro';
import { credentials } from '../data/credentials';
import PathFinder from '../components/PathFinder.astro';
import CredentialCard from '../components/CredentialCard.astro';

const featuredCredentials = credentials.slice(0, 4);
---

<BaseLayout 
  title="TestPrepPilot — Find the credential path that fits your future" 
  description="Navigate your career with clear, requirement-based credential guidance."
>
  <section class="hero | container | animate-on-scroll">
    <div class="hero-content">
      <p class="eyebrow">YOUR CAREER, MADE LEGIBLE</p>
      <h1>The Optimal Path to Pass Any <em>Exam</em>.</h1>
      <p class="lede">Independently researched, data-backed preparation roadmaps designed to save you time and maximize your score.</p>
      <div class="cta-group">
        <a href="/explore" class="button">Find your exam</a>
        <a href="/reviews" class="button button-small" style="background:transparent; color:var(--ink); border: 1px solid var(--line);">All reviews</a>
      </div>
      <p class="proof-line"><small>Built around official state and national requirements.</small></p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="hero-gradient-blob"></div>
      <div class="glass-card path-card" style="top: 15%; left: 10%; animation: float 6s ease-in-out infinite;">
        <span class="step-num">01</span> Explore
      </div>
      <div class="glass-card path-card" style="top: 45%; right: 5%; animation: float 7s ease-in-out infinite alternate;">
        <span class="step-num">02</span> Compare
      </div>
      <div class="glass-card path-card" style="bottom: 15%; left: 20%; animation: float 8s ease-in-out infinite;">
        <span class="step-num">03</span> Move
      </div>
    </div>
  </section>

  <section id="path-finder" class="pathfinder-section | bg-cream | animate-on-scroll">
    <div class="container">
      <PathFinder />
    </div>
  </section>

  <section class="featured-section | container | animate-on-scroll">
    <div class="section-header">
      <h2>Popular career pathways</h2>
      <a href="/explore" class="view-all">View all &rarr;</a>
    </div>
    <div class="credential-grid">
      {featuredCredentials.map(cred => (
        <CredentialCard credential={cred} />
      ))}
    </div>
  </section>

  <section class="trust-band | bg-ink color-paper | animate-on-scroll">
    <div class="container trust-layout">
      <div class="trust-stat">100%</div>
      <div class="trust-content">
        <p class="eyebrow">NO BLACK BOXES</p>
        <h2>Every recommendation starts with the requirement—not the sale.</h2>
        <p>We analyze state and national requirements first, ensuring you only see valid pathways to your chosen career. Our methodology is public, clear, and designed to serve you.</p>
        <a href="/methodology" class="btn btn-outline color-paper">Read our methodology</a>
      </div>
    </div>
  </section>

  <section class="how-it-works-section | container | animate-on-scroll">
    <div class="two-column-layout">
      <div class="visual-column">
        <div class="grid-pattern">
          <div class="stamp">THE CLEAR PATH</div>
          <div class="card-element"></div>
        </div>
      </div>
      <div class="content-column">
        <p class="eyebrow">HOW WE HELP</p>
        <h2>Less searching. <em>Better deciding.</em></h2>
        <ol class="step-list">
          <li>
            <h3>Understand the route</h3>
            <p>Clear breakdowns of requirements, prerequisites, and realistic timelines.</p>
          </li>
          <li>
            <h3>Compare meaningful options</h3>
            <p>Side-by-side evaluations of legitimate providers that meet your needs.</p>
          </li>
          <li>
            <h3>Take the next step</h3>
            <p>Actionable guidance to start your certification or licensure process today.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="newsletter-section | bg-primary color-paper | animate-on-scroll">
    <div class="container">
      <div class="newsletter-content">
        <h2>Get practical career guidance, occasionally.</h2>
        <form id="newsletter-form" class="newsletter-form">
          <input type="email" placeholder="Your email address" required aria-label="Email address" />
          <button type="submit" class="btn btn-ink">Subscribe</button>
        </form>
        <div id="newsletter-success" class="newsletter-success" hidden>
          <p><strong>Thanks for subscribing!</strong> Check your inbox for the next steps.</p>
        </div>
        <p class="disclaimer"><small>No spam. Unsubscribe anytime. See our <a href="/privacy">Privacy Policy</a>.</small></p>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('astro:page-load', () => {
      const form = document.getElementById('newsletter-form');
      const success = document.getElementById('newsletter-success');
      
      if (form && success) {
        // Remove existing listener to prevent duplicates if it was somehow preserved
        const newForm = form.cloneNode(true);
        form.parentNode.replaceChild(newForm, form);
        
        newForm.addEventListener('submit', (e) => {
          e.preventDefault();
          newForm.style.display = 'none';
          success.hidden = false;
          // In a real app, you would send the data to an API here.
        });
      }
    });
  </script>
</BaseLayout>

<style>
  /* Local component styles for layout structure. Relying on global CSS for visual design. */
  .container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
  .bg-cream { background-color: var(--cream); }
  .bg-ink { background-color: var(--ink); color: var(--paper); }
  .bg-primary { background-color: var(--primary); }
  .color-paper { color: var(--paper); }
  .color-ink { color: var(--ink); }
  
  .hero { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; min-height: 80vh; padding-top: 4rem; }
  .hero-content h1 { font-size: 4rem; line-height: 1.1; margin-bottom: 1.5rem; }
  .cta-group { display: flex; gap: 1rem; align-items: center; margin: 2rem 0; }
  
  /* Enhanced Hero Art */
  .hero-art { position: relative; width: 100%; height: 500px; display: flex; justify-content: center; align-items: center; }
  .hero-gradient-blob {
    position: absolute;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, var(--primary) 0%, rgba(239, 101, 78, 0) 70%);
    opacity: 0.4;
    filter: blur(40px);
    border-radius: 50%;
    animation: pulseBlob 8s infinite alternate;
  }
  .glass-card {
    position: absolute;
    background: var(--glass-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--glass-border);
    padding: 1rem 1.5rem;
    border-radius: var(--radius-lg);
    font-family: var(--font-heading);
    font-size: 1.125rem;
    box-shadow: var(--shadow-md);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .step-num { font-family: var(--font-mono); color: var(--primary); font-size: 0.875rem; font-weight: bold; }
  
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
    100% { transform: translateY(0px); }
  }
  @keyframes pulseBlob {
    0% { transform: scale(1); opacity: 0.4; }
    100% { transform: scale(1.2); opacity: 0.6; }
  }

  .pathfinder-section { padding: 4rem 0; }
  .featured-section { padding: 6rem 0; }
  .section-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem; }
  .credential-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; }
  
  .trust-band { padding: 6rem 0; }
  .trust-layout { display: grid; grid-template-columns: auto 1fr; gap: 4rem; align-items: center; }
  .trust-stat { font-size: 8rem; font-family: var(--font-serif); line-height: 1; }
  
  .how-it-works-section { padding: 8rem 0; }
  .two-column-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .step-list { list-style: none; padding: 0; counter-reset: step; }
  .step-list li { position: relative; padding-left: 3rem; margin-bottom: 2rem; }
  .step-list li::before { counter-increment: step; content: "0" counter(step); position: absolute; left: 0; top: 0; font-family: var(--font-mono); font-size: 1.25rem; font-weight: bold; color: var(--primary); }
  .visual-column { position: relative; height: 100%; min-height: 400px; background: var(--cream); display: flex; align-items: center; justify-content: center; }
  .grid-pattern { width: 80%; height: 80%; background-image: radial-gradient(var(--ink) 1px, transparent 1px); background-size: 20px 20px; opacity: 0.2; position: relative; }
  .stamp { position: absolute; top: -1rem; left: -1rem; background: var(--primary); color: var(--paper); padding: 0.5rem 1rem; font-family: var(--font-mono); font-size: 0.875rem; font-weight: bold; transform: rotate(-5deg); z-index: 10; opacity: 1 !important; }
  
  .newsletter-section { padding: 3rem 0; text-align: center; }
  .newsletter-form { display: flex; gap: 1rem; justify-content: center; max-width: 500px; margin: 2rem auto; }
  .newsletter-form input { flex: 1; padding: 1rem; border: 2px solid var(--ink); font-family: var(--font-body); }
  .newsletter-form button { padding: 1rem 2rem; font-weight: bold; border: 2px solid var(--ink); cursor: pointer; }
</style>
