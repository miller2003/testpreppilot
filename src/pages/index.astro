---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildDirectory } from '../data/examCatalog/index.mjs';
import { jurisdictions } from '../data/examCatalog/index.mjs';

// Homepage IS the directory. Data-driven from the manifest-gated catalog, so any
// exam released in release-manifest.mjs appears here automatically on rebuild.
const directory = buildDirectory().map((cat) => ({
  ...cat,
  exams: cat.groups
    .flatMap((g) => g.exams)
    .sort((a, b) => a.name.localeCompare(b.name)),
}));
const totalExams = directory.reduce((n, c) => n + c.exams.length, 0);
const catCount = directory.length;

// State list for the filter <select> (sorted by name for easy scanning).
const stateList = [...jurisdictions].sort((a, b) => a.name.localeCompare(b.name));

const title = 'TestPrepPilot — The U.S. Exam, License & Certification Directory';
const description = `A clean, source-checked directory of U.S. exams, licenses and certifications across ${catCount} professions. Search any credential and open a verified preparation roadmap.`;

// Uniform, scannable meta line; the issuer + full prose stay on each detail page.
const metaOf = (e) =>
  e.type && e.group ? `${e.type} · ${e.group}` : e.blurb || '';

// The live filter matches against this lowercased haystack (cheap includes()).
const hayOf = (e) =>
  [e.name, e.type, e.group, e.stateName, e.blurb, e.short, ...(e.aka || [])]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();

// Richer precomputed index for the autocomplete combobox: name + initials +
// short acronym + aka list, so "CPA" → "Uniform CPA Examination" and
// "cdl gk" → "CDL General Knowledge" both resolve.
const searchIndex = directory
  .flatMap((c) => c.exams)
  .map((e) => {
    const n = e.name.toLowerCase();
    const w = n.split(/\s+/);
    return {
      name: e.name,
      href: e.href,
      scope: e.scope,
      state: e.stateCode || '',
      meta: metaOf(e),
      n,
      w,
      ini: w.map((s) => s[0]).join(''),
      short: (e.short || '').toLowerCase(),
      aka: (e.aka || []).map((a) => a.toLowerCase()),
    };
  });
const idxJson = JSON.stringify(searchIndex);

// ── ItemList graph (GEO step 3) ────────────────────────────────────────
// The homepage previously shipped no page-level structured data beyond the
// site-wide Organization/WebSite/WebPage nodes. For a directory that is a
// real omission: ItemList is the one type that tells a parser "this URL is an
// enumerated collection of these N things", which is exactly the shape a
// "list of X certifications" query needs. Both lists are generated from the
// same `directory` array the page renders, so they cannot drift.
const SITE = 'https://testpreppilot.com';
const allEntries = directory.flatMap((c: any) => c.exams);

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE}/#directory`,
  name: title,
  description,
  url: SITE + '/',
  isPartOf: { '@id': `${SITE}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    name: 'U.S. exams, licenses and certifications',
    numberOfItems: totalExams,
    itemListElement: allEntries.map((e: any, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE}/exams/${e.slug}`,
      name: e.name
    }))
  },
  about: {
    '@type': 'ItemList',
    name: 'Credential fields covered',
    numberOfItems: catCount,
    itemListElement: directory.map((c: any, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE}/categories/${c.id}`,
      name: c.name
    }))
  }
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <section class="hero | container">
    <h1 class="hero-title">The Optimal Path to Pass Any <em>Exam</em>.</h1>
    {/* Answer-first: the count and the scope come before the brand promise. */}
    <p class="hero-sub">
      Verified guides to {totalExams} U.S. exams, licenses and certifications across {catCount} professions —
      each one researched against the issuing body's own published rules and linked to the primary source.
    </p>
    <p class="hero-stat">
      {totalExams} credentials &middot; {catCount} professions &middot; every entry source-checked
    </p>
    <p class="hero-note"><span class="hero-dot" aria-hidden="true"></span>Continuously updated &middot; new guides added regularly</p>
  </section>

  <!-- Single source of truth for search + filter. Sticks under the header on scroll. -->
  <div class="dir-bar" id="dir-bar">
    <div class="dir-bar-inner | container">
      <div class="dir-search">
        <div class="combobox">
          <label for="dir-q" class="sr-only">Search exams and credentials</label>
          <input
            id="dir-q"
            type="search"
            placeholder={`Search ${totalExams} exams & credentials…`}
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="combo-list"
            aria-autocomplete="list"
            aria-label="Search exams and credentials"
          />
          <ul class="combobox-list" id="combo-list" role="listbox" aria-label="Suggestions" hidden></ul>
        </div>
      </div>

      <!-- Mobile-only entry point. Opens the filter sheet below; hidden ≥901px,
           where the same form renders inline exactly as it always has. -->
      <button
        type="button"
        class="filter-trigger"
        id="filter-trigger"
        aria-expanded="false"
        aria-controls="filter-panel"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="7" y1="12" x2="17" y2="12"></line>
          <line x1="10" y1="17" x2="14" y2="17"></line>
        </svg>
        <span class="filter-trigger-label">Filters</span>
        <span class="filter-badge" id="filter-badge" hidden></span>
      </button>

      <!-- One form, two layouts. ≥901px the shell and panel are `display: contents`,
           so the form is a plain flex item of the bar. ≤900px the shell becomes a
           fixed overlay and the panel a bottom sheet. No duplicated controls, no
           ID collisions, and the desktop row is byte-for-byte the same markup. -->
      <div class="filter-shell" id="filter-shell">
        <div class="filter-backdrop" id="filter-backdrop" aria-hidden="true"></div>
        <div class="filter-panel" id="filter-panel" tabindex="-1">
          <div class="filter-grab" id="filter-grab" aria-hidden="true"></div>
          <div class="filter-head">
            <h2 class="filter-title" id="filter-title">Filters</h2>
            <button type="button" class="filter-close" id="filter-close" aria-label="Close filters">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <form class="dir-filters" id="dir-filters" aria-label="Filter exams">
            <span class="field-label" aria-hidden="true">Scope</span>
            <div class="seg" role="group" aria-label="Exam scope">
              <button type="button" class="seg-btn is-active" data-scope="all">All</button>
              <button type="button" class="seg-btn" data-scope="national">National</button>
              <button type="button" class="seg-btn" data-scope="state">State</button>
            </div>

            <label class="field-label" for="f-state">State</label>
            <select id="f-state" aria-label="Filter by state" disabled>
              <option value="">All states</option>
              {stateList.map((s) => <option value={s.code}>{s.name}</option>)}
            </select>
            <p class="filter-hint" id="f-state-hint">Choose “State” above to filter by one state.</p>

            <label class="field-label" for="f-cat">Category</label>
            <select id="f-cat" aria-label="Filter by category">
              <option value="">All categories</option>
              {directory.map((cat) => <option value={cat.id}>{cat.name}</option>)}
            </select>

            <p class="filter-preview" id="filter-preview" aria-live="polite"></p>

            <div class="filter-actions">
              <button type="submit" class="btn btn-primary" id="f-apply">Apply</button>
              <button type="button" class="btn btn-ghost" id="f-reset">Reset</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Applied filters, mobile only: tap a chip to drop just that facet. -->
      <div class="filter-chips" id="filter-chips" hidden></div>
    </div>
  </div>

  <div class="dir-body | container">
    <p class="dir-count" id="dir-count" aria-live="polite"></p>

    {directory.map((cat, i) => (
      <section class="cat" id={cat.id} data-cat={cat.id}>
        <header class="cat-head">
          <span class="cat-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="cat-headtext">
            <h2 class="cat-name">{cat.name}</h2>
            <p class="cat-desc">{cat.description}</p>
          </div>
          <span class="cat-count">{cat.exams.length}</span>
        </header>

        <ul class="exam-grid">
          {cat.exams.map((exam) => (
            <li
              class="exam"
              data-cat={cat.id}
              data-hay={hayOf(exam)}
              data-scope={exam.scope}
              data-state={exam.stateCode || ''}
            >
              <a class="exam-row" href={exam.href}>
                <span class="exam-text">
                  <span class="exam-name">{exam.name}</span>
                  <span class="exam-meta">{metaOf(exam)}</span>
                </span>
                <span class="exam-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="dir-empty" id="dir-empty" hidden>
      <p>Nothing matches that search.</p>
      <button type="button" id="dir-reset">Clear search &amp; filters</button>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ idxJson }}>
  document.addEventListener('astro:page-load', () => {
    const combo = document.getElementById('dir-q');
    const list = document.getElementById('combo-list');
    const form = document.getElementById('dir-filters');
    const segBtns = Array.from(document.querySelectorAll('.seg-btn'));
    const stateSel = document.getElementById('f-state');
    const catSel = document.getElementById('f-cat');
    const resetBtn = document.getElementById('f-reset');
    const cats = Array.from(document.querySelectorAll('.cat'));
    const items = Array.from(document.querySelectorAll('.exam'));
    const countEl = document.getElementById('dir-count');
    const emptyEl = document.getElementById('dir-empty');
    const dirReset = document.getElementById('dir-reset');
    const bar = document.getElementById('dir-bar');
    const trigger = document.getElementById('filter-trigger');
    const badge = document.getElementById('filter-badge');
    const shell = document.getElementById('filter-shell');
    const panel = document.getElementById('filter-panel');
    const backdrop = document.getElementById('filter-backdrop');
    const closeBtn = document.getElementById('filter-close');
    const grab = document.getElementById('filter-grab');
    const chipsEl = document.getElementById('filter-chips');
    const applyBtn = document.getElementById('f-apply');
    const previewEl = document.getElementById('filter-preview');
    const stateHint = document.getElementById('f-state-hint');
    if (!combo || !items.length) return;

    const INDEX = JSON.parse(idxJson);

    // 900px matches the header's own desktop/mobile switch, so the bar and the
    // nav never change personality at different widths.
    const mq = window.matchMedia('(max-width: 900px)');
    const canInert = 'inert' in HTMLElement.prototype;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const PH_DESKTOP = `Search ${items.length} exams & credentials\u2026`;
    const PH_MOBILE = `Search ${items.length} exams\u2026`;

    let query = '';        // live: the search box filters as you type
    let activeScope = 'all'; // committed facets: only ever changed through a commit
    let activeState = '';
    let activeCat = '';

    // Honour ?q= from the WebSite SearchAction (sitelinks search box).
    const params = new URLSearchParams(window.location.search);
    const qp = params.get('q');
    if (qp) {
      combo.value = qp;
      query = qp.trim().toLowerCase();
    }

    /* ── Filter (committed) ─────────────────────────────────────────── */
    function matchesWith(it, f) {
      if (f.scope !== 'all' && (it.dataset.scope || '') !== f.scope) return false;
      if (f.scope === 'state' && f.state && (it.dataset.state || '').toUpperCase() !== f.state.toUpperCase()) return false;
      if (f.cat && (it.dataset.cat || '') !== f.cat) return false;
      if (f.query && !(it.dataset.hay || '').includes(f.query)) return false;
      return true;
    }

    function countMatching(f) {
      let n = 0;
      for (const it of items) if (matchesWith(it, f)) n++;
      return n;
    }

    function matches(it) {
      return matchesWith(it, { scope: activeScope, state: activeState, cat: activeCat, query });
    }

    function apply() {
      let visible = 0;
      for (const it of items) {
        const show = matches(it);
        it.hidden = !show;
        if (show) visible++;
      }
      for (const c of cats) {
        const anyVisible = Array.from(c.querySelectorAll('.exam')).some((x) => !x.hidden);
        c.hidden = !anyVisible;
      }
      if (emptyEl) emptyEl.hidden = visible !== 0;
      if (countEl) {
        countEl.textContent =
          query === '' && activeScope === 'all' && activeCat === ''
            ? `${visible} credentials`
            : `${visible} of ${items.length} match`;
      }
    }

    function optionLabel(sel, val) {
      const o = Array.from(sel.options).find((x) => x.value === val);
      return o ? o.textContent.trim() : val;
    }

    /* ── Facets → badge + chips (mobile chrome) ──────────────────────── */
    function activeFacets() {
      const f = [];
      if (activeScope !== 'all') f.push({ key: 'scope', label: activeScope === 'state' ? 'State' : 'National' });
      if (activeScope === 'state' && activeState) f.push({ key: 'state', label: optionLabel(stateSel, activeState) });
      if (activeCat) f.push({ key: 'cat', label: optionLabel(catSel, activeCat) });
      return f;
    }

    function syncChrome() {
      const facets = activeFacets();
      if (badge) {
        badge.hidden = facets.length === 0;
        badge.textContent = String(facets.length);
      }
      if (trigger) trigger.classList.toggle('is-active', facets.length > 0);
      if (chipsEl) {
        chipsEl.hidden = facets.length === 0;
        chipsEl.innerHTML = facets
          .map(
            (f) =>
              `<button type="button" class="filter-chip" data-facet="${f.key}" aria-label="Remove filter: ${esc(f.label)}">` +
              `<span class="filter-chip-text">${esc(f.label)}</span><span class="filter-chip-x" aria-hidden="true">&times;</span></button>`
          )
          .join('');
      }
      if (stateHint) stateHint.hidden = activeScope === 'state';
    }

    /* ── Scope segmented control: commits immediately, on every width ──
       It reads as a tab, so it behaves like one. (Previously it wrote straight
       into the committed scope but never re-ran the filter, so the list and the
       control could disagree until something else triggered a re-filter.) */
    function setScope(scope, btn) {
      activeScope = scope;
      segBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
      stateSel.disabled = scope !== 'state';
      if (scope !== 'state') { stateSel.value = ''; activeState = ''; }
      else { activeState = stateSel.value; }
      apply();
      syncChrome();
      syncPreview();
    }
    segBtns.forEach((btn) => {
      btn.addEventListener('click', () => setScope(btn.dataset.scope, btn));
    });

    /* ── Commit on Apply / Show results ─────────────────────────────── */
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (isSheetOpen()) commitSheet();
        else {
          activeState = stateSel.value;
          activeCat = catSel.value;
          apply();
          syncChrome();
        }
      });
    }

    if (chipsEl) {
      chipsEl.addEventListener('click', (e) => {
        const chip = e.target.closest('.filter-chip');
        if (!chip) return;
        const key = chip.dataset.facet;
        if (key === 'scope') setScope('all', segBtns.find((b) => b.dataset.scope === 'all'));
        else {
          if (key === 'state') { activeState = ''; stateSel.value = ''; }
          if (key === 'cat') { activeCat = ''; catSel.value = ''; }
          apply();
          syncChrome();
          syncPreview();
        }
      });
    }

    function resetAll() {
      activeScope = 'all';
      activeState = '';
      activeCat = '';
      query = '';
      combo.value = '';
      segBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.scope === 'all'));
      stateSel.value = '';
      stateSel.disabled = true;
      catSel.value = '';
      closeCombo();
      apply();
      syncChrome();
      syncPreview();
      snapshot = null; // a reset is a deliberate commit — nothing left to cancel
    }
    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (dirReset) dirReset.addEventListener('click', resetAll);

    [stateSel, catSel].forEach((sel) => {
      sel.addEventListener('change', syncPreview);
    });

    /* ── Mobile filter sheet ─────────────────────────────────────────── */
    let snapshot = null;      // applied facets at the moment the sheet opened
    let lastFocused = null;

    function isSheetOpen() {
      return !!shell && shell.classList.contains('is-open');
    }

    function syncControlsFromApplied() {
      segBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.scope === activeScope));
      stateSel.disabled = activeScope !== 'state';
      stateSel.value = activeScope === 'state' ? activeState : '';
      catSel.value = activeCat;
    }

    function openSheet() {
      if (!shell || !trigger || isSheetOpen()) return;
      syncControlsFromApplied();
      snapshot = { scope: activeScope, state: stateSel.value, cat: catSel.value };
      lastFocused = document.activeElement;
      panel.style.transform = '';
      shell.classList.add('is-open');
      if (canInert) shell.inert = false;
      trigger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      syncPreview();
      // Focusing the dialog itself makes screen readers announce the heading,
      // then the first Tab lands on the scope control.
      try { panel.focus({ preventScroll: true }); } catch (e) {}
    }

    function closeSheet() {
      if (!shell || !isSheetOpen()) return;
      panel.style.transform = '';
      shell.classList.remove('is-open');
      if (canInert) shell.inert = true;
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      const back = lastFocused && lastFocused !== document.body && document.contains(lastFocused) ? lastFocused : trigger;
      if (back && back.focus) { try { back.focus({ preventScroll: true }); } catch (e) {} }
    }

    function commitSheet() {
      activeState = stateSel.value;
      activeCat = catSel.value;
      apply();
      syncChrome();
      closeSheet();
      scrollToResults();
    }

    // Cancel means cancel: the scope commits live inside the sheet (it is a
    // toggle), so roll it back to the value that was in force on open.
    function cancelSheet() {
      if (snapshot) {
        if (snapshot.scope !== activeScope) {
          activeScope = snapshot.scope;
          segBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.scope === snapshot.scope));
          stateSel.disabled = activeScope !== 'state';
        }
        activeState = activeScope === 'state' ? snapshot.state : '';
        activeCat = snapshot.cat;
        stateSel.value = activeState;
        catSel.value = activeCat;
        apply();
        syncChrome();
      }
      closeSheet();
    }

    function scrollToResults() {
      const body = document.querySelector('.dir-body');
      if (!body) return;
      const off = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--scroll-offset')) || 72;
      const y = Math.max(0, body.getBoundingClientRect().top + window.scrollY - off - 8);
      if (Math.abs(window.scrollY - y) < 8) return;
      window.scrollTo({ top: y, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    }

    /* Live count for the pending selection — the primary button says what
       pressing it will actually produce. */
    function readControls() {
      const seg = segBtns.find((b) => b.classList.contains('is-active'));
      return { scope: seg ? seg.dataset.scope : 'all', state: stateSel.value, cat: catSel.value };
    }

    function syncPreview() {
      const d = readControls();
      const n = countMatching({ scope: d.scope, state: d.state, cat: d.cat, query });
      if (previewEl) {
        previewEl.textContent =
          n === items.length ? `All ${items.length} credentials` : `${n} of ${items.length} credentials match`;
      }
      if (applyBtn) {
        applyBtn.textContent = mq.matches
          ? n === 0 ? 'No matches' : `Show ${n} ${n === 1 ? 'result' : 'results'}`
          : 'Apply';
      }
    }

    if (trigger) {
      trigger.addEventListener('click', () => (isSheetOpen() ? cancelSheet() : openSheet()));
    }
    if (backdrop) backdrop.addEventListener('click', cancelSheet);
    if (closeBtn) closeBtn.addEventListener('click', cancelSheet);
    shell.addEventListener('click', (e) => {
      if (e.target === shell) cancelSheet();     // click outside the sheet body
    });

    /* Drag the grabber / header down to dismiss. */
    if (grab) {
      let startY = 0;
      let startT = 0;
      let dy = 0;
      let dragging = false;
      const onStart = (e) => {
        if (!isSheetOpen() || !e.touches || e.touches.length !== 1) return;
        dragging = true;
        dy = 0;
        startY = e.touches[0].clientY;
        startT = Date.now();
        panel.style.transition = 'none';
      };
      const onMove = (e) => {
        if (!dragging) return;
        dy = Math.max(0, e.touches[0].clientY - startY);
        panel.style.transform = `translateY(${dy}px)`;
        if (e.cancelable) e.preventDefault();
      };
      const onEnd = () => {
        if (!dragging) return;
        dragging = false;
        panel.style.transition = '';
        const fast = dy > 40 && Date.now() - startT < 400;
        if (dy > 110 || fast) cancelSheet();
        else panel.style.transform = '';
      };
      const dragTarget = panel.querySelector('.filter-head');
      (dragTarget || grab).addEventListener('touchstart', onStart, { passive: true });
      (dragTarget || grab).addEventListener('touchmove', onMove, { passive: false });
      (dragTarget || grab).addEventListener('touchend', onEnd);
      (dragTarget || grab).addEventListener('touchcancel', onEnd);
    }

    /* Focus trap + Escape while the sheet is open (the page behind stays inert). */
    document.addEventListener('keydown', (e) => {
      if (!isSheetOpen()) return;
      if (e.key === 'Escape') { e.preventDefault(); cancelSheet(); return; }
      if (e.key !== 'Tab') return;
      const focusables = Array.from(
        shell.querySelectorAll('button, select, input, a[href], [tabindex]:not([tabindex="-1"])')
      ).filter((el) => !el.disabled && el.offsetParent !== null);
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const act = document.activeElement;
      if (e.shiftKey && (act === first || act === panel)) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && act === last) { e.preventDefault(); first.focus(); }
    });

    /* Layout switch: dialog semantics, inertness and the placeholder all follow
       the breakpoint, so neither layout carries the other's behaviour. */
    function syncLayout() {
      if (mq.matches) {
        if (panel) {
          panel.setAttribute('role', 'dialog');
          panel.setAttribute('aria-modal', 'true');
          panel.setAttribute('aria-labelledby', 'filter-title');
        }
        if (shell && canInert && !isSheetOpen()) shell.inert = true;
        combo.placeholder = PH_MOBILE;
      } else {
        if (panel) {
          panel.removeAttribute('role');
          panel.removeAttribute('aria-modal');
          panel.removeAttribute('aria-labelledby');
        }
        if (shell) {
          shell.classList.remove('is-open');
          if (canInert) shell.inert = false;
        }
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        combo.placeholder = PH_DESKTOP;
      }
      syncPreview();
    }
    if (mq.addEventListener) mq.addEventListener('change', syncLayout);

    /* ── Search: live filter + autocomplete combobox ─────────────────── */
    function scoreExam(e, tokens) {
      let total = 0;
      for (const t of tokens) {
        let best = 0;
        if (e.n === t) best = Math.max(best, 1000);
        if (e.short === t) best = Math.max(best, 950);
        if (e.aka.includes(t)) best = Math.max(best, 900);
        if (e.n.startsWith(t)) best = Math.max(best, 600);
        if (e.short.startsWith(t) || e.aka.some((a) => a.startsWith(t))) best = Math.max(best, 520);
        if (e.n.includes(t)) best = Math.max(best, 420);
        if (e.short.includes(t) || e.aka.some((a) => a.includes(t))) best = Math.max(best, 380);
        const wordStart = e.w.filter((w) => w.startsWith(t)).length;
        if (wordStart) best = Math.max(best, 140 + wordStart * 10);
        if (e.ini.includes(t)) best = Math.max(best, 120);
        const wordSub = e.w.filter((w) => w.includes(t)).length;
        if (wordSub) best = Math.max(best, 70 + wordSub * 8);
        if (best === 0) return -1;
        total += best;
      }
      return total;
    }

    function esc(s) {
      return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    }

    let suggestions = [];
    let activeOpt = -1;

    function renderCombo() {
      if (!suggestions.length) { closeCombo(); return; }
      list.innerHTML = suggestions
        .map((e, i) => {
          const scopeTag = e.scope === 'state' ? 'State' : 'National';
          const extra = e.state ? ` · ${esc(e.state)}` : '';
          return `<li class="combobox-opt${i === activeOpt ? ' is-active' : ''}" role="option" id="combo-opt-${i}" aria-selected="${i === activeOpt}" data-i="${i}">
            <span class="co-name">${esc(e.name)}</span>
            <span class="co-meta">${scopeTag}${extra}</span>
          </li>`;
        })
        .join('');
      list.hidden = false;
      combo.setAttribute('aria-expanded', 'true');
      if (activeOpt >= 0) combo.setAttribute('aria-activedescendant', `combo-opt-${activeOpt}`);
      else combo.removeAttribute('aria-activedescendant');
    }

    function openCombo() { if (suggestions.length) { list.hidden = false; combo.setAttribute('aria-expanded', 'true'); } }
    function closeCombo() { list.hidden = true; combo.setAttribute('aria-expanded', 'false'); activeOpt = -1; combo.removeAttribute('aria-activedescendant'); }

    function buildSuggestions() {
      const q = combo.value.trim().toLowerCase();
      if (!q) { closeCombo(); return; }
      const tokens = q.split(/\s+/).filter(Boolean);
      suggestions = INDEX
        .map((e) => {
          const s = scoreExam(e, tokens);
          return s < 0 ? null : { e, s };
        })
        .filter(Boolean)
        .sort((a, b) => b.s - a.s)
        .slice(0, 8)
        .map((x) => x.e);
      activeOpt = -1;
      renderCombo();
    }

    function move(dir) {
      if (!suggestions.length) return;
      activeOpt = (activeOpt + dir + suggestions.length) % suggestions.length;
      renderCombo();
      const el = document.getElementById(`combo-opt-${activeOpt}`);
      if (el) el.scrollIntoView({ block: 'nearest' });
    }

    function go(href) { window.location.href = href; }

    combo.addEventListener('input', () => {
      query = combo.value.trim().toLowerCase();
      apply();
      buildSuggestions();
      syncPreview();
    });
    combo.addEventListener('focus', () => { if (combo.value.trim()) buildSuggestions(); });
    combo.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); openCombo(); move(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      else if (e.key === 'Enter') {
        if (activeOpt >= 0 && suggestions[activeOpt]) { e.preventDefault(); go(suggestions[activeOpt].href); }
      } else if (e.key === 'Escape') { closeCombo(); }
    });
    list.addEventListener('click', (e) => {
      const opt = e.target.closest('.combobox-opt');
      if (!opt) return;
      const i = Number(opt.dataset.i);
      if (suggestions[i]) go(suggestions[i].href);
    });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.combobox')) closeCombo();
    });

    /* ── Sticky bar elevation ────────────────────────────────────────── */
    if (bar) {
      const sentinel = document.createElement('div');
      sentinel.setAttribute('aria-hidden', 'true');
      bar.parentNode.insertBefore(sentinel, bar);
      const off = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--scroll-offset')) || 72;
      const io = new IntersectionObserver(
        (entries) => bar.classList.toggle('is-stuck', !entries[0].isIntersecting),
        { rootMargin: `-${off}px 0px 0px 0px`, threshold: 0 }
      );
      io.observe(sentinel);
    }

    apply();
    syncLayout();
    syncChrome();
  });
</script>

