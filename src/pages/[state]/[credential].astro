---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExamGuide from '../../components/ExamGuide.astro';
import SchemaMarkup from '../../components/SchemaMarkup.astro';
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro';
import { getStateByCode } from '../../data/states';
import { credentials } from '../../data/credentials';
import examEditorial from '../../data/examEditorial.mjs';
import { stateCredTitle, clampDesc } from '../../lib/seoTitle';

export function getStaticPaths() {
  const paths: any[] = [];

  credentials.forEach(cred => {
    if (cred.stateSpecificData) {
      Object.keys(cred.stateSpecificData).forEach(stateCode => {
        const stateInfo = getStateByCode(stateCode);
        if (stateInfo) {
          paths.push({
            params: { state: stateInfo.slug, credential: cred.slug },
            props: { stateInfo, credential: cred, stateData: cred.stateSpecificData[stateCode] }
          });
        }
      });
    }
  });

  return paths;
}

const { stateInfo, credential, stateData } = Astro.props;
const ex = examEditorial[credential.slug] || null;

// Sibling states offering the same credential — turns a dead-end leaf into a
// hub-and-spoke node and gives the cluster reciprocal links.
const siblingStates = Object.keys(credential.stateSpecificData || {})
  .filter((code) => code !== stateInfo.code)
  .map((code) => getStateByCode(code))
  .filter(Boolean)
  .sort((a: any, b: any) => a.name.localeCompare(b.name));

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: stateInfo.name, href: `/${stateInfo.slug}` },
  { label: credential.name, href: `/${stateInfo.slug}/${credential.slug}` }
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": `${credential.name} in ${stateInfo.name}`,
  "description": stateData.description || credential.description || credential.tagline,
  "provider": {
    "@type": "Organization",
    "name": credential.providers?.[0]?.name || "Various Providers"
  }
};
---

<BaseLayout
  title={stateCredTitle(credential.name, stateInfo.name)}
  description={clampDesc(
    stateData.description ||
      `${stateInfo.name} board requirements, fees, exam format and timeline for the ${credential.name}.`
  )}
  ogImage="/og-state.png"
  ogType="article"
>
  <SchemaMarkup type="Course" data={schemaData} />
  <BreadcrumbSchema items={breadcrumbItems} />
  <ExamGuide credential={credential} ex={ex} breadcrumbs={breadcrumbItems} stateInfo={stateInfo} stateData={stateData} />

  <section class="cred-crosslinks">
    <div class="container">
      <div class="xl-grid">
        <div class="xl-col">
          <h2>Licensing in other states</h2>
          {siblingStates.length > 0 ? (
            <ul class="xl-list">
              {siblingStates.map((s: any) => (
                <li>
                  <a href={`/${s.slug}/${credential.slug}`}>{credential.name} in {s.name}</a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="xl-empty">
              This is currently the only state guide we publish for this credential.
            </p>
          )}
          <p class="xl-more">
            <a href={`/paths/${credential.slug}`}>National overview: {credential.name}</a>
          </p>
        </div>
        <div class="xl-col">
          <h2>More in {stateInfo.name}</h2>
          <ul class="xl-list">
            <li><a href={`/${stateInfo.slug}`}>All {stateInfo.name} licenses &amp; certifications</a></li>
            <li><a href="/states">Browse licensing by state</a></li>
            <li><a href="/exams">Full exam directory</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cred-crosslinks { padding: 2.5rem 0; border-top: 1px solid rgba(0, 0, 0, 0.08); }
  .cred-crosslinks .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
  .xl-grid { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .xl-col h2 { font-size: 1.25rem; margin: 0 0 0.75rem; }
  .xl-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .xl-list a { text-decoration: none; }
  .xl-list a:hover { text-decoration: underline; }
  .xl-empty, .xl-more { margin: 0.75rem 0 0; opacity: 0.8; font-size: 0.95rem; }
</style>
