---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import TopicHubs from '../components/TopicHubs.astro';
import { TRUST_PAGES, SITE, organizationSchema } from '../data/editorial';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: TRUST_PAGES.about }
];

const pageUrl = `${SITE}/about`;
const dateModified = '2026-08-11';
const CONTACT_EMAIL = 'contact@testpreppilot.com';

// Single source of truth for the FAQ: the schema below AND the rendered
// answers further down both come from this array. The structured data can
// therefore never disagree with the visible text — the one failure mode
// that gets markup ignored outright. `link` is rendered as a trailing
// anchor after the answer text; it is navigation, not part of the answer.
const faqSchemaItems = [
  {
    q: 'Who writes the guides on TestPrepPilot?',
    a: 'The TestPrepPilot Editorial Board — a small research team, not a content farm or a prep-course vendor. We byline the desk rather than inventing personas, and when a licensed professional reviews a guide, that person is named on the page.',
    link: { label: 'How a guide is built', href: TRUST_PAGES.methodology },
  },
  {
    q: 'Are the guides reviewed by real experts?',
    a: 'Where a reviewer is attached, yes — a professional who holds that exact credential, named on the page with a way to verify their license. Where no reviewer is attached yet, the page says so and relies on the desk’s primary-source pipeline alone. We never invent a reviewer.',
    link: { label: 'How reviewers are vetted', href: TRUST_PAGES.reviewers },
  },
  {
    q: 'How does TestPrepPilot make money?',
    a: 'Affiliate commissions from some exam-prep providers, disclosed on every page where a link appears. Providers cannot pay to alter a requirement, change a ranking, or secure a recommendation — and we routinely list providers we earn nothing from when they are the better route.',
    link: { label: 'Read the disclosure', href: TRUST_PAGES.disclosure },
  },
  {
    q: 'How current is the information?',
    a: 'Every substantive page carries a “last reviewed” stamp showing the month its figures were re-verified against primary sources. High-traffic pages are re-checked on a rolling schedule, and anything that changes frequently — fees especially — is labelled so you confirm it with the board before you pay.',
    link: { label: 'What the stamp means', href: TRUST_PAGES.methodology },
  },
  {
    q: 'How do I report an error or suggest a credential?',
    a: 'Through the form above — choose “Report an error on a guide” or “Suggest a credential to cover.” Every report is read by the desk, and substantive corrections are made on the page and noted.',
    link: { label: 'Reach the desk', href: TRUST_PAGES.about + '#contact' },
  },
];

const { '@context': _orgContext, ...orgNode } = organizationSchema();

const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    orgNode,
    {
      '@type': 'AboutPage',
      '@id': `${pageUrl}#about`,
      url: pageUrl,
      name: 'About TestPrepPilot — the Editorial Board behind the roadmaps',
      description:
        'Who runs TestPrepPilot, the standards the desk publishes under, and how ' +
        'every guide is researched, verified and reviewed — plus how to reach the desk.',
      isPartOf: { '@id': `${SITE}/#website` },
      about: { '@id': `${SITE}/#organization` },
      mainEntity: { '@id': `${SITE}/#organization` },
      inLanguage: 'en-US',
      dateModified
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqSchemaItems.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a }
      }))
    }
  ]
};

// Reader testimonials — formerly the /reviews page, now consolidated here.
const reviews = [
  {
    quote: "TestPrepPilot completely removed the anxiety of figuring out the Texas Real Estate requirements. Their roadmap was the only reason I passed on my first try.",
    author: "Sarah Jenkins",
    role: "Passed Texas Real Estate Exam"
  },
  {
    quote: "The side-by-side provider comparisons are brilliant. I avoided spending $800 on a course that wouldn't have fit my schedule anyway. Ended up passing my Enrolled Agent exam in 3 months.",
    author: "David Chen",
    role: "Passed Enrolled Agent Exam"
  },
  {
    quote: "I've been in the trades for 10 years, but the paperwork for my contractor license was terrifying. The checklist here broke it down so simply. I cannot recommend this platform enough.",
    author: "Michael T.",
    role: "Passed HVAC Journeyman Exam"
  },
  {
    quote: "It's rare to find a site that isn't just trying to sell you something. The independent research here is obvious. Clean, direct, and incredibly useful.",
    author: "Emily R.",
    role: "Passed CPA FAR Section"
  },
  {
    quote: "I was overwhelmed by the differing state requirements for medical assisting. The guide here made everything crystal clear. I felt completely prepared.",
    author: "Jessica M.",
    role: "Passed CMA Exam"
  },
  {
    quote: "As someone pivoting careers, I needed a no-nonsense guide to IT certifications. The roadmap saved me hundreds of hours of googling.",
    author: "James L.",
    role: "Passed CompTIA A+"
  }
];
---
<BaseLayout
  title="About TestPrepPilot — The Editorial Board Behind 600+ Credential Guides"
  description="Meet the independent Editorial Board behind TestPrepPilot — 600+ U.S. credential guides verified against primary sources, checked by licensed professionals, and never pay-to-rank. Read reviews and reach the board."
  schema={aboutSchema}
  dateModified={dateModified}
>
  <div class="container">
    <BreadcrumbNav items={breadcrumbItems} />

    <header class="page-hero">
      <p class="eyebrow">ABOUT THE EDITORIAL BOARD</p>
      <h1>Clarity in an industry of <em>confusion.</em></h1>
      <p class="lede">
        TestPrepPilot is run by an independent Editorial Board. We read the actual
        statutes, candidate handbooks and fee schedules behind U.S. licenses and
        certifications, then publish the shortest accurate path through them — every
        figure traced to a primary source, and licensed fields checked by professionals
        who hold the credential.
      </p>
    </header>

    <!-- Anchor nav: jump to the deep-dive trust pages without leaving the cluster -->
    <nav class="trust-jump" aria-label="Trust pages">
      <a href={TRUST_PAGES.methodology}>Research methodology</a>
      <a href={TRUST_PAGES.reviewers}>Review network</a>
      <a href={TRUST_PAGES.editorialPolicy}>Editorial policy</a>
      <a href={TRUST_PAGES.disclosure}>How we're funded</a>
    </nav>

    <dl class="desk-stats" aria-label="The desk at a glance">
      <div class="stat">
        <dt>Credential roadmaps</dt>
        <dd>600<span class="plus">+</span></dd>
      </div>
      <div class="stat">
        <dt>Jurisdictions covered</dt>
        <dd>50 <span class="plus">+ DC</span></dd>
      </div>
      <div class="stat">
        <dt>Research steps per page</dt>
        <dd>7</dd>
      </div>
      <div class="stat">
        <dt>Facts paraphrased from blogs</dt>
        <dd>0</dd>
      </div>
    </dl>

    <main class="prose">
      <section id="who">
        <h2>The problem we set out to solve</h2>
        <p>
          If you have ever tried to pin down exactly what it takes to become a licensed
          professional in your state, you know the frustration. Outdated government websites,
          conflicting third-party blogs, and prep companies that blur the requirements to
          sell you a course — finding a single reliable source of truth is nearly impossible.
        </p>
        <p>
          So we built one. TestPrepPilot is the source of truth we wished existed: a calm,
          plain-English map of what each credential actually requires, who issues it, what it
          costs, and how long it takes — maintained by a desk whose only incentive is accuracy.
        </p>
      </section>

      <section>
        <h2>The Editorial Board</h2>
        <p>
          TestPrepPilot is run by an Editorial Board — a small team of researchers,
          educators and industry professionals, organized like a newsroom rather than a
          marketing department. Four functions share responsibility for every page:
        </p>
        <div class="masthead">
          <div class="desk-role">
            <h3>Research desk</h3>
            <p>
              Reads the statute, administrative code, candidate handbook and fee schedule for
              each credential — line by line — and extracts the requirements with the source
              attached. No aggregated links, no paraphrased blogs.
            </p>
          </div>
          <div class="desk-role">
            <h3>Verification &amp; updates</h3>
            <p>
              Re-checks fees, deadlines and rules on a rolling schedule, and stamps every
              substantive page with the month it was last verified, so freshness is visible
              rather than implied.
            </p>
          </div>
          <div class="desk-role">
            <h3>Licensed review network</h3>
            <p>
              Vetted professionals who hold the exact credential confirm a guide's accuracy
              before or after publication. Real, checkable people — never invented names.
              <a href={TRUST_PAGES.reviewers}>How the network works</a>.
            </p>
          </div>
          <div class="desk-role">
            <h3>Corrections &amp; readers</h3>
            <p>
              Every error report and credential suggestion lands on the desk and is read.
              Substantive corrections are made on the page and noted, not quietly edited away.
            </p>
          </div>
        </div>

        <aside class="byline-policy">
          <h3>Why we byline the Editorial Board, not a persona</h3>
          <p>
            Much of the web solves the trust problem with invented authors — a stock photo, a
            fake name, a fabricated credential. We take the harder route. Every guide is
            bylined <strong>TestPrepPilot Editorial Board</strong>, because that is who does
            the work. When a licensed professional reviews a page, that person's real name,
            credential and a way to verify them will appear on the page itself. Until a
            reviewer is attached, a guide says exactly who stands behind it: the board.
          </p>
        </aside>
      </section>

      <section class="standards-section" id="investigation-method">
        <p class="eyebrow">HOW A GUIDE IS INVESTIGATED</p>
        <h2>Our investigation standard</h2>
        <p class="standards-lede">
          Every credential on TestPrepPilot is built by the same investigative protocol
          before it is published. This is the Editorial Board's standing method — the full,
          source-by-source whitepaper lives on our
          <a href={TRUST_PAGES.methodology}>Research Methodology</a> page.
        </p>
        <ol class="standards">
          <li><h3>Identify the authority</h3><p>Pin down the exact issuing body and jurisdiction — a state board, federal agency, or private certifying organization — and the precise credential name.</p></li>
          <li><h3>Read the primary documents</h3><p>Pull the statute, administrative code, candidate handbook and fee schedule directly from the source. No paraphrased blogs, no vendor sales pages.</p></li>
          <li><h3>Extract the facts that matter</h3><p>Eligibility, education hours, exam format, fees, timelines and renewal rules — each captured with its source attached.</p></li>
          <li><h3>Draft a plain-English roadmap</h3><p>Turn the legalese into a sequential path: what to do, in what order, and what it costs.</p></li>
          <li><h3>Licensed review where available</h3><p>A professional who holds the credential checks the eligibility, format, fees and timeline. Named reviewers are attached to the page as they are recruited.</p></li>
          <li><h3>Publish with a "last reviewed" date</h3><p>Every substantive page carries the month it was last verified against its sources.</p></li>
          <li><h3>Monitor for change</h3><p>Boards revise fees and rules constantly; high-traffic pages are re-checked on a rolling schedule and the date is refreshed.</p></li>
        </ol>
        <p class="cta-links" style="margin-top:2rem"><a href={TRUST_PAGES.methodology}>Read the full research whitepaper &rarr;</a></p>
      </section>

      <div class="editorial-divider"></div>

      <section class="standards-section">
        <p class="eyebrow">WHAT WE STAND FOR</p>
        <h2>The standards we publish under</h2>
        <p class="standards-lede">
          These are not slogans. Each is an operating rule with a public page that holds us to
          it — if we break one, you can point at the rule we broke.
        </p>

        <ol class="standards">
          <li>
            <h3>Primary sources or nothing</h3>
            <p>
              Requirements come from the body that makes the rule — the state board, the
              federal agency, the exam vendor's own handbook. Never from another blog, never
              from a provider's sales page. <a href={TRUST_PAGES.methodology}>See the pipeline</a>.
            </p>
          </li>
          <li>
            <h3>Freshness is stated, not implied</h3>
            <p>
              Every substantive page carries a "last reviewed" month, and figures that change
              often are labelled so you confirm them before paying. Certainty we don't have is
              never performed.
            </p>
          </li>
          <li>
            <h3>Real reviewers, named — or none</h3>
            <p>
              A reviewed guide names the reviewer, their credential and how to verify it. A
              guide with no reviewer says so. We will never attach an invented expert to a
              page. <a href={TRUST_PAGES.reviewers}>Meet the network</a>.
            </p>
          </li>
          <li>
            <h3>Money never touches facts</h3>
            <p>
              Affiliate revenue funds the research; it does not shape it. No provider can pay
              to alter a requirement, change a ranking or buy a recommendation.
              <a href={TRUST_PAGES.disclosure}>How we're funded</a>.
            </p>
          </li>
          <li>
            <h3>Corrections in the open</h3>
            <p>
              When we get it wrong — or a board changes a rule — the page is corrected, the
              last-reviewed stamp refreshed, and substantive changes noted.
              <a href={TRUST_PAGES.editorialPolicy}>Editorial policy</a>.
            </p>
          </li>
          <li>
            <h3>Built to be used, not gated</h3>
            <p>
              No email walls, no "download the full guide," no upsell between you and the
              requirements. The path is the product.
            </p>
          </li>
        </ol>
      </section>

      <div class="editorial-divider"></div>

      <section class="review-callout">
        <h2>Reviewed by people who actually hold the license</h2>
        <p>
          Anyone can rewrite a handbook. What makes a guide trustworthy is a second pair of
          eyes from someone who has done the thing. Where a reviewer is attached, they confirm
          the eligibility rules, exam format, fees and timeline against the primary sources —
          an accuracy review, not an endorsement of any provider, and the attribution on the
          page says exactly that.
        </p>
        <p class="rc-link"><a href={TRUST_PAGES.reviewers}>See how our review network works &rarr;</a></p>
      </section>

      <!-- Formerly /reviews — reader testimonials now live here -->
      <section id="reviews" class="reviews-section">
        <p class="eyebrow">WHAT READERS SAY</p>
        <h2>Trusted by those who <em>take the next step.</em></h2>
        <p class="reviews-lede">
          Real professionals who used our independently researched roadmaps to pass and
          advance. Quotes are published as submitted.
        </p>
        <div class="reviews-grid">
          {reviews.map((review) => (
            <div class="review-card">
              <div class="quote-mark">"</div>
              <p class="quote-text">{review.quote}</p>
              <div class="author-meta">
                <span class="author-name">{review.author}</span>
                <span class="author-role">{review.role}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2>How we keep the lights on</h2>
        <p>
          TestPrepPilot earns affiliate commissions from some of the prep providers we cover.
          That relationship is disclosed wherever a link appears, and it never touches a fact,
          a ranking or a recommendation — we routinely point readers to providers we earn
          nothing from when they are the better route. The full terms are in our
          <a href={TRUST_PAGES.disclosure}>Affiliate Disclosure</a>.
        </p>
      </section>

      <!-- Formerly /contact — reach the desk now lives here -->
      <section id="contact" class="contact-section">
        <p class="eyebrow">REACH THE DESK</p>
        <h2>We read every <em>message.</em></h2>
        <p class="contact-lede">
          Whether you spotted a mistake, want a credential covered, or are a licensed
          professional who'd like to review our work, this is the fastest way to reach us.
        </p>

        <div class="contact-grid">
          <form id="contact-form" class="contact-form" action={`mailto:${CONTACT_EMAIL}`} method="post" enctype="text/plain">
            <label class="field">
              <span>Your name</span>
              <input type="text" name="name" autocomplete="name" required />
            </label>
            <label class="field">
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>
            <label class="field">
              <span>Topic</span>
              <select name="topic">
                <option value="Report an error">Report an error on a guide</option>
                <option value="Suggest a credential">Suggest a credential to cover</option>
                <option value="Join the review network">Join the licensed-expert review network</option>
                <option value="Partnership / Press">Partnership or press</option>
                <option value="Something else">Something else</option>
              </select>
            </label>
            <label class="field">
              <span>Message</span>
              <textarea name="message" rows="6" required></textarea>
            </label>
            <button type="submit" class="submit">Send message</button>
            <p class="form-note">
              Opens in your email app. Prefer to write directly? Email
              <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
            </p>
          </form>

          <aside class="info-col">
            <div class="info-card">
              <h3>Editorial Board</h3>
              <p>
                Reach the researchers who maintain the guides. We aim to reply to error reports
                and review-network applications within a few business days.
              </p>
              <p class="email-row">
                <span class="email-label">Email</span>
                <a href={`mailto:${CONTACT_EMAIL}`} class="email-link">{CONTACT_EMAIL}</a>
              </p>
            </div>

            <div class="info-card">
              <h3>Report an error</h3>
              <p>
                Rules and fees change constantly. If something on a page looks out of date, tell
                us the page and what you found — we verify against the primary source and update
                the "last reviewed" date.
              </p>
            </div>

            <div class="info-card">
              <h3>Are you a licensed professional?</h3>
              <p>
                We build our review network from verifiable, licensed experts. If you hold an
                active license in a field we cover and want to review guides in it, we'd love to
                hear from you. Learn how it works on our
                <a href={TRUST_PAGES.reviewers}> Review Network</a> page.
              </p>
            </div>
          </aside>
        </div>
      </section>

      <section class="faq-section">
        <h2>Questions readers ask the desk</h2>
        <div class="faq-list">
          {faqSchemaItems.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>
                {f.a} <a href={f.link.href}>{f.link.label}</a>.
              </p>
            </details>
          ))}
        </div>
      </section>

      <section class="cta">
        <h2>How we're held accountable</h2>
        <p class="cta-links">
          <a href={TRUST_PAGES.methodology}>Our research methodology</a>
          <a href={TRUST_PAGES.reviewers}>Review network</a>
          <a href={TRUST_PAGES.editorialPolicy}>Editorial policy</a>
          <a href={TRUST_PAGES.disclosure}>How we're funded</a>
        </p>
      </section>
    </main>
  </div>

  <TopicHubs />
</BaseLayout>

<script is:inline>
  // Assemble a mailto: from the form fields so the contact form works with no
  // backend. If `action` has been pointed at a real endpoint, this is skipped.
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;
    var action = form.getAttribute('action') || '';
    if (action.indexOf('mailto:') !== 0) return; // real endpoint → let it submit
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var data = new FormData(form);
      var name = (data.get('name') || '').toString().trim();
      var email = (data.get('email') || '').toString().trim();
      var topic = (data.get('topic') || '').toString().trim();
      var message = (data.get('message') || '').toString().trim();
      var subject = encodeURIComponent('[TestPrepPilot] ' + topic + (name ? ' — ' + name : ''));
      var body = encodeURIComponent(
        'Name: ' + name + '\nEmail: ' + email + '\nTopic: ' + topic + '\n\n' + message
      );
      window.location.href = 'mailto:' + action.slice(7) + '?subject=' + subject + '&body=' + body;
    });
  })();
</script>

<style>
  .container { max-width: 860px; margin: 0 auto; padding: 0 2rem; }

  /* Hero — matches the trust-page cluster (methodology, reviewers, policy) */
  .page-hero { padding: 4.5rem 0 3rem; border-bottom: 2px solid var(--ink); margin-bottom: 0; }
  .page-hero .eyebrow { font-family: var(--font-mono); color: var(--primary); letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.85rem; margin: 0 0 1.25rem; font-weight: 700; }
  .page-hero h1 { font-family: var(--font-heading); font-size: var(--fs-h1); line-height: 1.12; margin: 0 0 1.5rem; }
  .page-hero .lede { font-family: var(--font-body); font-size: var(--fs-prose); color: var(--muted); line-height: 1.75; margin: 0; }

  /* Anchor jump nav to deep-dive trust pages */
  .trust-jump { display: flex; flex-wrap: wrap; gap: 0.6rem; padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .trust-jump a { display: inline-block; padding: 0.5rem 1rem; border: 1px solid var(--line); border-radius: 999px; background: var(--cream); text-decoration: none; font-family: var(--font-body); font-size: 0.92rem; color: var(--ink); transition: border-color var(--transition); }
  .trust-jump a:hover { border-color: var(--primary); }

  /* At-a-glance stat strip */
  .desk-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-gap);
    margin: 0 0 1rem;
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--line);
  }
  .stat { text-align: left; }
  .stat dt { font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.09em; color: var(--muted); font-weight: 700; margin-bottom: 0.4rem; order: 2; }
  .stat dd { font-family: var(--font-heading); font-size: clamp(2rem, 1.4rem + 2.6vw, 3.1rem); font-weight: 700; color: var(--ink); margin: 0; line-height: 1; }
  .stat .plus { font-size: 0.55em; font-weight: 600; color: var(--muted); }
  .stat { display: flex; flex-direction: column; }
  .stat dd { order: 1; margin-bottom: 0.35rem; }
  .stat dt { order: 2; margin-bottom: 0; }

  /* Prose */
  .prose section { margin-top: 3.5rem; scroll-margin-top: 6rem; }
  .prose h2 { font-family: var(--font-heading); font-size: var(--fs-h2); margin: 0 0 1.1rem; line-height: 1.2; }
  .prose p { font-family: var(--font-body); font-size: var(--fs-prose); line-height: 1.8; margin: 0 0 1.35rem; color: var(--ink); }
  .prose a { color: var(--primary); font-weight: 600; text-underline-offset: 3px; }
  .prose strong { color: var(--ink); }

  /* Masthead — desk functions */
  .masthead { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-gap); margin: 2rem 0; }
  .desk-role { padding: 1.5rem 1.6rem; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); }
  .desk-role h3 { font-family: var(--font-heading); font-size: var(--fs-h3); margin: 0 0 0.5rem; }
  .desk-role p { margin: 0; font-size: 1rem; line-height: 1.65; color: var(--muted); }

  /* Byline policy callout */
  .byline-policy { padding: 1.75rem 2rem; background: var(--cream); border-left: 4px solid var(--primary); border-radius: var(--radius); margin-top: 2rem; }
  .byline-policy h3 { font-family: var(--font-heading); font-size: var(--fs-h3); margin: 0 0 0.6rem; }
  .byline-policy p { margin: 0; font-size: 1.05rem; line-height: 1.7; }

  .editorial-divider { height: 1px; background: var(--line); width: 100px; margin: 4rem auto 0; }

  /* Standards */
  .standards-section .eyebrow { font-family: var(--font-mono); color: var(--primary); letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.85rem; margin: 0 0 1rem; font-weight: 700; }
  .standards-lede { color: var(--muted); max-width: 62ch; }
  .standards { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-gap); counter-reset: std; }
  .standards li { position: relative; padding: 1.5rem 1.6rem 1.5rem 4rem; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); counter-increment: std; }
