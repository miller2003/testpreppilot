---
import BaseLayout from '../layouts/BaseLayout.astro';

// "How it works" is now covered inside the /about E-E-A-T hub (who's behind the
// desk, the research pipeline, and how a guide is built). Forward the URL to /about.
const target = 'https://testpreppilot.com/about';
---
<BaseLayout
  title="How it works — TestPrepPilot"
  description="How TestPrepPilot turns regulations into clear roadmaps is now explained on our About page."
  canonical={target}
>
  <meta http-equiv="refresh" content="0; url=/about" />
  <div class="container" style="max-width:760px;margin:0 auto;padding:6rem 2rem;text-align:center;">
    <h1 style="font-family:var(--font-heading);font-size:2rem;margin-bottom:1rem;">How it works has moved</h1>
    <p style="color:var(--muted);margin-bottom:1.5rem;">
      See how the Editorial Board researches and verifies every guide on our <a href="/about">About the board</a> page.
    </p>
    <a href="/about" class="button">Continue to About</a>
  </div>
</BaseLayout>

<script is:inline>
  window.location.replace('/about');
</script>
