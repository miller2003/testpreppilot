---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'How it works', href: '/how-it-works' }
];
---

<BaseLayout 
  title="How It Works — TestPrepPilot"
  description="Learn how to use TestPrepPilot to find and pursue your next career milestone."
>
  <div class="container | animate-on-scroll">
    <BreadcrumbNav items={breadcrumbItems} />
    
    <header class="page-hero">
      <p class="eyebrow">HOW IT WORKS</p>
      <h1>A more useful way to <em>move forward.</em></h1>
      <p class="lede">We've designed this platform to cut through the noise and get you straight to the information that matters.</p>
    </header>

    <main class="principles">
      <section class="principle">
        <div class="numeral">01</div>
        <h2>Start with a goal</h2>
        <p>Use our Path Finder or browse our directory to locate the exact certification or license required for your desired role. We cover everything from entry-level IT certifications to complex state-by-state medical licenses.</p>
      </section>
      
      <section class="principle">
        <div class="numeral">02</div>
        <h2>See the full route</h2>
        <p>Our guides lay out the exact steps, prerequisites, costs, and time commitments. No surprises. We distill hundreds of pages of regulatory jargon into simple, sequential checklists.</p>
      </section>
      
      <section class="principle">
        <div class="numeral">03</div>
        <h2>Choose deliberately</h2>
        <p>Review our side-by-side comparisons of approved educational providers and exam prep materials. Find the option that fits your budget and schedule, then take the next step with confidence.</p>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .container { max-width: 900px; margin: 0 auto; padding: 2rem; }
  
  .page-hero { padding: 4rem 0; border-bottom: 2px solid var(--ink); margin-bottom: 4rem; text-align: center; }
  .page-hero h1 { font-size: 4rem; margin: 1rem 0; }
  .page-hero .lede { font-size: 1.5rem; color: #444; max-width: 700px; margin: 0 auto; }
  
  .principles { display: grid; gap: 4rem; margin-bottom: 6rem; }
  .principle { background: var(--cream); padding: 3rem; border-radius: 4px; border: 1px solid var(--ink); box-shadow: 4px 4px 0 var(--ink); position: relative; }
  .numeral { font-family: var(--font-mono); font-size: 4rem; color: var(--primary); font-weight: bold; position: absolute; top: -2rem; left: 2rem; background: var(--paper); padding: 0 1rem; border: 1px solid var(--ink); }
  .principle h2 { font-size: 2.5rem; font-family: var(--font-serif); margin-top: 1rem; margin-bottom: 1rem; }
  .principle p { font-size: 1.25rem; line-height: 1.6; color: var(--ink); }
</style>
