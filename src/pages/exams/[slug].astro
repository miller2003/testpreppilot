  .eg-sourcelink { color: var(--primary); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .eg-reviewed { font-family: var(--font-mono); font-size: 0.82rem; color: var(--muted); opacity: 0.8; margin-top: 1rem; }

