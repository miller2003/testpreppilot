---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import { examTitle } from '../../lib/seoTitle';
import DepthSections from '../../components/DepthSections.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import RelatedExams from '../../components/RelatedExams.astro';
import SidebarTOC from '../../components/SidebarTOC.astro';
import { depthFor, depthSections } from '../../data/examCatalog/examDepth.mjs';
import { releaseDateFor } from '../../data/examCatalog/release-manifest.mjs';
import {
  allExams,
  getExamDetail,
  getExamsByCategory,
  categoryById
} from '../../data/examCatalog/index.mjs';

export function getStaticPaths() {
  return allExams
    .filter((e) => e.status === 'stub')
    .map((exam) => ({ params: { slug: exam.slug }, props: { exam } }));
}

const { exam } = Astro.props;
const detail = getExamDetail(exam.slug) || { dossier: null, compact: null, peers: [], memberStates: [] };
const { dossier, compact, compactNote, peers, memberStates, offeringCount } = detail;
const { record = null, program = null, siblings = [], relatedResolved = [] } = detail;

const cat = categoryById[exam.category];
const accentVar =
  cat?.color === 'emerald' ? 'var(--accent-mint)'
  : cat?.color === 'ink' ? 'var(--ink)'
  : `var(--accent-${cat?.color})`;

const isState = !!exam.stateCode;
const scopeLabel = isState ? `${exam.stateName} (${exam.stateCode})` : 'National / Multi-state';

// Four page modes:
//   'researched'  → state dossier, this jurisdiction issues the credential
//   'not-offered' → state dossier, this jurisdiction does NOT issue it (honest page)
//   'national'    → researched national credential (rich, gold-standard layout)
//   'placeholder' → nothing researched yet
const mode = dossier
  ? exam.offered === false
    ? 'not-offered'
    : 'researched'
  : record
    ? 'national'
    : 'placeholder';

const facts = exam.facts || null;

// Only pages with verified substance are indexable. A national record has to
// carry a real body of content before we let search engines at it — a thin
// stub competing for a high-volume query does more harm than no page at all.
const indexable = mode !== 'placeholder';

// ── national-mode view models ───────────────────────────────────────
const meta = record?.examMeta || null;
const topics = record?.topics || [];
const essentials = record?.examEssentials || [];
const costs = record?.costBreakdown || null;
const natTimeline = record?.timeline || [];
const natFaqs = [...(record?.faqs || []), ...(program?.orgFaqs || [])];
const regSteps = program?.registrationSteps || [];

// Body-level policies only worth a section if at least one is populated.
const policies = program
  ? [
      ['Proctoring & delivery', program.proctoring],
      ['Retake policy', program.retakePolicy],
      ['Score reporting', program.scoreReporting],
      ['Recertification', program.recertification],
      ['Refunds & rescheduling', program.refundPolicy]
    ].filter(([, v]) => v)
  : [];

const natComparison = program?.comparison || null;

// ── Answer-first lines (GEO rule 2.2) ───────────────────────────────────
// Each major section opens with one sentence that states the answer and leads
// with its figures. Retrieval systems — AI Overviews, Perplexity, ChatGPT
// browsing — chunk by heading and usually keep only the first sentence or two
// of each chunk. A section that opens with "Weightings come from the official
// exam outline" contributes nothing quotable; one that opens with the fee and
// the time limit does.
const bodyName = program?.body || exam.body || 'the awarding body';
const f = (v: any) => String(v || '').replace(/\s+/g, ' ').trim();
const isNumericish = (v: any) => /\d/.test(String(v || ''));
const isRealPassMark = (v: any) => isNumericish(v) && !/^no\b/i.test(String(v || ''));

const formatAnswer = (() => {
  if (mode !== 'national' || !meta) return '';
  const parts: string[] = [];
  if (meta.time) parts.push(`runs ${f(meta.time)}`);
  const q = f(meta.questions);
  if (q && /^\d/.test(q)) parts.push(`contains ${q.replace(/\s*questions?\s*$/i, '')} questions`);
  if (isRealPassMark(meta.pass)) parts.push(`requires ${f(meta.pass)} to pass`);
  if (!parts.length) return '';
  const joined =
    parts.length === 1
      ? parts[0]
      : `${parts.slice(0, -1).join(', ')} and ${parts[parts.length - 1]}`;
  return `The ${exam.name} is administered by ${f(meta.admin) || bodyName} and ${joined}.`;
})();

const costAnswer = (() => {
  if (mode !== 'national') return '';
  const bits: string[] = [];
  if (meta?.fee) bits.push(`the exam fee is ${f(meta.fee)}`);
  if (record.cost) bits.push(`the all-in cost is typically ${f(record.cost)}`);
  if (record.time) bits.push(`most candidates spend ${f(record.time)} preparing`);
  if (!bits.length) return '';
  return `For the ${exam.name}, ${bits.join('; ')}.`;
})();

const topicAnswer = (() => {
  if (mode !== 'national' || topics.length === 0) return '';
  const weighted = topics.filter((t: any) => t.weight);
  if (!weighted.length) return `The ${exam.name} covers ${topics.length} content domains.`;
  const top = weighted
    .slice(0, 3)
    .map((t: any) => `${f(t.name)} (${f(t.weight)})`)
    .join(', ');
  return `The ${exam.name} is weighted across ${topics.length} domains; the largest are ${top}.`;
})();

const glanceAnswer = (() => {
  const bits: string[] = [];
  bits.push(`${exam.name} is a ${f(exam.type).toLowerCase()} credential`);
  if (mode === 'national') {
    if (bodyName && bodyName !== 'the awarding body') bits.push(`awarded by ${bodyName}`);
    if (meta?.fee) bits.push(`the exam fee is ${f(meta.fee)}`);
    if (record.time) bits.push(`typical preparation is ${f(record.time)}`);
    if (record.salaryRange) bits.push(`holders typically earn ${f(record.salaryRange)}`);
  } else if (mode === 'researched') {
    if (facts?.agency) bits.push(`issued in ${exam.stateName} by ${f(facts.agency)}`);
  }
  return `${bits.join('; ')}.`;
})();

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Exams', href: '/' },
  { label: cat?.name || 'Exams', href: `/categories/${exam.category}` },
  { label: exam.name, href: `/exams/${exam.slug}` }
];

// Superseded by <RelatedExams />. The old rule was
//   same category AND same stateCode, .slice(0, 8)
// which (a) returned nothing for national exams in thin categories — hence the
// 61 pages stuck at 2-3 inbound links — and (b) always handed the links to the
// same first 8 rows, so the tail of each category never received any.

const peerSample = peers.slice(0, 24);

// Shared depth layer — the eight deep-dive sections plus the named reviewer.
// Only national pages carry it; state dossiers and placeholders are unaffected.
// Declared up here because the sidebar TOC also reads depthNav to cluster the
// eight P0 depth sections under two umbrella chapter headings.
const depth = mode === 'national' ? depthFor(exam.slug) : null;
const depthNav = depthSections(depth);

const buildingBlocks = [
  { t: 'Eligibility & Requirements', d: 'Education, experience and prerequisites you need before you can sit.' },
  { t: 'The Exam in Detail', d: 'Question counts, time limits, pass marks, format and content outline.' },
  { t: 'Costs & Timeline', d: 'Fees, study windows and how long the whole path typically takes.' },
  { t: 'Approved Providers', d: 'Vetted prep schools and how their affiliate offers compare.' },
  { t: 'Your Step-by-Step Route', d: 'A plain-English walk through from today to licensed.' },
  { t: 'FAQ', d: 'The questions real candidates ask, answered from primary sources.' }
];

function clampMeta(text) {
  const s = String(text || '').replace(/\s+/g, ' ').trim();
  if (s.length <= 158) return s;
  const cut = s.slice(0, 155);
  return `${cut.slice(0, cut.lastIndexOf(' '))}…`;
}

// ── Sidebar TOC ────────────────────────────────────────────────────────────
// Editorial chapter navigation. The previous flat list grew past 17 items on
// gold-standard national pages and overflowed the viewport. We now group items
// under four chapter headings, with cluster labels rolling the eight P0 depth
// sections under two umbrella items. The old code also had a famous bug: the
// `costs || natTimeline.length` expression evaluated to the literal number 0
// when both were falsy, which JSX happily rendered as a stray "0" in the nav.
// Every condition is now a strict boolean.
const tocItems: { id: string; label: string; sub?: boolean; chapterTitle?: string }[] = [];
const pushIf = (cond: any, item: typeof tocItems[number]) => { if (cond) tocItems.push(item); };
const subItem = (id: string, label: string) => ({ id, label, sub: true });

// Chapter 1 — The basics
const showQuickAnswer = mode === 'national' && !!record.quickAnswer;
if (showQuickAnswer) {
  tocItems.push({ id: 'quick', label: 'Quick answer', chapterTitle: 'The basics' });
  tocItems.push({ id: 'overview', label: 'Overview' });
} else {
  tocItems.push({ id: 'overview', label: 'Overview', chapterTitle: 'The basics' });
}
pushIf(mode === 'not-offered', { id: 'instead', label: 'What applies instead' });

// Chapter 2 — What you need (eligibility + the exam)
const showEligibility = mode === 'researched' || (mode === 'national' && !!(record.prerequisites || record.eligibility));
const showExam = mode === 'researched' || (mode === 'national' && !!meta);
if (showEligibility) {
  tocItems.push({ id: 'eligibility', label: 'Eligibility', chapterTitle: 'What you need' });
  if (showExam) {
    tocItems.push({ id: 'exam', label: 'The exam' });
    pushIf(mode === 'national' && topics.length > 0, subItem('topics', 'What is tested'));
  }
} else if (showExam) {
  tocItems.push({ id: 'exam', label: 'The exam', chapterTitle: 'What you need' });
  pushIf(mode === 'national' && topics.length > 0, subItem('topics', 'What is tested'));
}

// Chapter 3 — Plan & pay (logistics)
const hasCosts = mode === 'researched' || (mode === 'national' && !!(costs || natTimeline.length));
const showHowToRegister = mode === 'national' && regSteps.length > 0;
const showStepByStep = mode === 'researched';
const showCompare = mode === 'national' && !!natComparison;
if (hasCosts) {
  tocItems.push({ id: 'costs', label: 'Costs & timeline', chapterTitle: 'Plan & pay' });
  pushIf(showStepByStep, { id: 'route', label: 'Step-by-step' });
  if (showHowToRegister) {
    tocItems.push({ id: 'register', label: 'How to register' });
    pushIf(policies.length > 0, subItem('policies', 'Rules & renewal'));
    pushIf(showCompare, { id: 'compare', label: 'How it compares' });
  } else {
    pushIf(showCompare, { id: 'compare', label: 'How it compares' });
  }
} else if (showStepByStep) {
  tocItems.push({ id: 'route', label: 'Step-by-step', chapterTitle: 'Plan & pay' });
} else if (showHowToRegister) {
  tocItems.push({ id: 'register', label: 'How to register', chapterTitle: 'Plan & pay' });
  pushIf(policies.length > 0, subItem('policies', 'Rules & renewal'));
  pushIf(showCompare, { id: 'compare', label: 'How it compares' });
}

// Chapter 4 — Career & preparation (depth sections clustered into 1-2 headings)
if (depthNav.length) {
  const career = depthNav.filter(d => d.id === 'salary' || d.id === 'pass-rate');
  const prep = depthNav.filter(d => d.id !== 'salary' && d.id !== 'pass-rate');

  if (career.length > 0) {
    const first = career[0];
    const extraCareerLabels: Record<string, string> = { 'pass-rate': 'Pass rates' };
    tocItems.push({
      id: first.id,
      label: first.id === 'salary' ? 'Career outlook' : (extraCareerLabels[first.id] || first.label),
      chapterTitle: prep.length > 0 ? 'Career' : 'Career & prep'
    });
    for (let i = 1; i < career.length; i++) {
      tocItems.push(subItem(career[i].id, extraCareerLabels[career[i].id] || career[i].label));
    }
    // When "Career outlook" is the label for #salary, sub #pass-rate reads "Pass rates"
    if (first.id === 'salary') {
      const pr = career.find(d => d.id === 'pass-rate');
      if (pr) {
        const idx = tocItems.findIndex(it => it.id === 'pass-rate');
        if (idx >= 0) tocItems[idx].label = 'Pass rates';
      }
    }
  }
  if (prep.length > 0) {
    const first = prep[0];
    const prepLabels: Record<string, string> = {
      'study-plan': 'Study plan',
      'strategies': 'Prep strategies',
      'resources': 'Study resources',
      'mistakes': 'Common mistakes',
      'question-types': 'Question types',
      'exam-day': 'Exam day'
    };
    tocItems.push({
      id: first.id,
      label: prep.length === 1 ? (prepLabels[first.id] || first.label) : 'Master the material',
      chapterTitle: career.length > 0 ? 'Preparation' : 'Career & prep'
    });
    for (let i = 1; i < prep.length; i++) {
      tocItems.push(subItem(prep[i].id, prepLabels[prep[i].id] || prep[i].label));
    }
  }
}

// Chapter 5 — Reference
const refItemsStart = tocItems.length;
const showFaq = (mode === 'researched' && !!dossier?.faqs?.length) ||
                (mode === 'national' && natFaqs.length > 0);
pushIf(mode === 'placeholder', { id: 'building', label: "What we're building" });
if (compact) {
  pushIf(true, { id: 'reciprocity', label: 'Cross-state validity', chapterTitle: 'Reference' });
  pushIf(true, { id: 'facts', label: 'At a glance' });
} else {
  pushIf(true, { id: 'facts', label: 'At a glance', chapterTitle: 'Reference' });
}
pushIf(showFaq, { id: 'faq', label: 'FAQ' });
pushIf(mode === 'national' && siblings.length > 0, { id: 'ladder', label: 'Others from this body' });
pushIf(peerSample.length > 0, { id: 'otherstates', label: 'Other states' });
tocItems.push({ id: 'sources', label: 'Sources' });

// Every branch is clamped, not just the national one. 65 pages were shipping
// descriptions over 160 characters (max 290), so Google rewrote or truncated
// them and the intended keyword tail never rendered in the SERP.
const metaDescription = clampMeta(
  mode === 'not-offered'
    ? `${exam.stateName} does not issue a state-level ${dossier.name.toLowerCase()}. Here is what applies instead, plus the ${offeringCount} states that do license it.`
    : mode === 'researched'
      ? `${exam.name}: requirements, exam format, fees and timeline. Issued by ${facts?.agency || dossier.defaultAgency}.`
      : mode === 'national'
        ? record.quickAnswer?.summary ||
          `${exam.name}: format, fees, topic weights, eligibility and how to register.`
        : exam.blurb
);

const canonicalUrl = new URL(`/exams/${exam.slug}`, Astro.site || 'https://testpreppilot.com').toString();

const schemaFaqs =
  mode === 'researched' ? dossier?.faqs || [] : mode === 'national' ? natFaqs : [];

const faqSchema = schemaFaqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: schemaFaqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a }
      }))
    }
  : null;


// A national credential is a real-world certification, so describe it as one
// rather than leaving search engines to infer it from an FAQ block alone.
const credentialSchema =
  mode === 'national'
    ? {
        '@context': 'https://schema.org',
        '@type': 'EducationalOccupationalCredential',
        name: exam.name,
        description: record.description || exam.blurb,
        url: canonicalUrl,
        credentialCategory: exam.type,
        ...(program?.body || exam.body
          ? {
              recognizedBy: {
                '@type': 'Organization',
                name: program?.body || exam.body,
                ...(program?.bodyUrl || exam.bodyUrl ? { url: program?.bodyUrl || exam.bodyUrl } : {})
              }
            }
          : {}),
        ...(record.prerequisites ? { competencyRequired: record.prerequisites } : {})
      }
    : null;

// Schema dates. `lastReviewed` records the month an editor last verified the
// content ("2026-08") — it is a review stamp, not a modification timestamp.
// Normalised to a day it can read as earlier than the page's own publication
// date, which emits a contradictory dateModified < datePublished. Clamp it: a
// page is never modified before it exists. The human-facing "Last reviewed"
// line in the byline is deliberately left alone — it answers a different
// question than dateModified and is an E-E-A-T signal, not a timestamp.
const publishedOn = releaseDateFor(exam.slug) || null;
const reviewedRaw = depth?.lastReviewed || record?.reviewed || null;
const reviewedIso = reviewedRaw
  ? reviewedRaw.length === 7
    ? `${reviewedRaw}-01`
    : reviewedRaw
  : null;
const modifiedOn = publishedOn && reviewedIso
  ? (reviewedIso < publishedOn ? publishedOn : reviewedIso)
  : reviewedIso || undefined;

// ── HowTo: the registration / licensing route ────────────────────────────
// Google's HowTo rich result was retired for desktop in 2023, but the markup
// is still parsed by LLM-based answer engines precisely because it states, in
// machine form, that this page contains an ordered procedure. Every step below
// is copied from the visible step list rendered further down — mismatched
// structured data is worse than none, so the two are built from the same array.
const routeSteps = mode === 'national'
  ? regSteps.map((s: any) => ({ name: s.title, text: s.description || s.title }))
  : mode === 'researched'
    ? (dossier?.route || []).map((s: any) => ({ name: s.title, text: s.description || s.title }))
    : [];

const howToSchema = routeSteps.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: mode === 'national'
        ? `How to register for the ${exam.name}`
        : `How to get licensed as a ${exam.name}`,
      description: mode === 'national'
        ? `The registration sequence for the ${exam.name}, from confirming eligibility to receiving the credential.`
        : `The licensing sequence for the ${exam.name} in ${exam.stateName}.`,
      totalTime: record?.time || undefined,
      estimatedCost: record?.cost
        ? { '@type': 'MonetaryAmount', currency: 'USD', value: String(record.cost).replace(/[^0-9.]/g, '') || undefined }
        : undefined,
      step: routeSteps.map((s: any, i: number) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: s.name,
        text: s.text
      }))
    }
  : null;

// ── Article: the citable wrapper ─────────────────────────────────────────
// WebPage alone tells a parser what the URL is. Article tells it who stands
// behind the claims (author / reviewedBy), when they were checked
// (datePublished / dateModified) and — critically for AI citation — which
// external sources the page relied on. `citation` is the field that turns a
// summariser into a referrer: it names the primary source to attribute.
const citations = [
  ...new Set(
    [
      program?.bodyUrl || exam.bodyUrl,
      record?.sourceUrl,
      program?.sourceUrl,
      facts?.agencyUrl,
      dossier?.sourceUrl,
      compact?.url
    ].filter(Boolean)
  )
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonicalUrl}#article`,
  headline: exam.name,
  description: metaDescription,
  url: canonicalUrl,
  mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
  inLanguage: 'en-US',
  author: { '@id': 'https://testpreppilot.com/#editorial-board' },
  publisher: { '@id': 'https://testpreppilot.com/#organization' },
  datePublished: publishedOn || undefined,
  dateModified: modifiedOn || publishedOn || undefined,
  ...(depth?.reviewedBy ? { reviewedBy: { '@type': 'Person', name: depth.reviewedBy } } : {}),
  ...(citations.length ? { citation: citations.map((u) => ({ '@type': 'WebPage', url: u })) } : {}),
  about: {
    '@type': 'Thing',
    name: exam.name,
    ...(exam.aka?.length ? { alternateName: exam.aka } : {})
  },
  // speakable marks the extractable answer region. Voice assistants and
  // snippet builders use it to find the passage worth reading aloud.
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.eg-quicksummary', '.eg-lead', '.eg-factstrip']
  },
  isAccessibleForFree: true
};
---

<BaseLayout
  title={examTitle(exam.name)}
  description={metaDescription}
  canonical={canonicalUrl}
  ogImage="/og-exam.png"
  dateModified={modifiedOn}
  datePublished={publishedOn || undefined}
  ogType="article"
  noindex={!indexable}
>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {credentialSchema && <script type="application/ld+json" set:html={JSON.stringify(credentialSchema)} />}
  {howToSchema && <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <header class="eg-hero" style={`--accent:${accentVar}`}>
    <div class="container">
      <BreadcrumbNav items={breadcrumbItems} />
      <p class="eyebrow">{cat?.name || exam.category} • {exam.type}</p>
      <h1>{exam.name}</h1>
      <p class="lede">{exam.blurb}</p>
      <AuthorByline author={depth?.author} lastReviewed={depth?.lastReviewed} placement="hero" />

      {mode === 'researched' && (
        <div class="eg-badges">
          <span class="eg-badge eg-badge-ok">Verified against official sources</span>
          {facts?.compactMember && compact && (
            <span class="eg-badge eg-badge-compact">{compact.name} member</span>
          )}
          {facts?.confidence === 'medium' && (
            <span class="eg-badge eg-badge-warn">Fees may change — confirm with the board</span>
          )}
        </div>
      )}
      {mode === 'not-offered' && (
        <div class="eg-badges">
          <span class="eg-badge eg-badge-none">No state-level license in {exam.stateName}</span>
        </div>
      )}
      {mode === 'national' && (
        <div class="eg-badges">
          <span class="eg-badge eg-badge-ok">Verified against {program?.body || exam.body} sources</span>
          {record.difficulty && <span class="eg-badge eg-badge-plain">{record.difficulty}</span>}
          {record.confidence === 'medium' && (
            <span class="eg-badge eg-badge-warn">Fees change — confirm before you book</span>
          )}
        </div>
      )}

      {mode === 'national' ? (
        <div class="eg-factstrip">
          <div class="eg-fact">
            <span class="label">Awarded by</span>
            <span class="value">{program?.body || exam.body || '—'}</span>
          </div>
          <div class="eg-fact">
            <span class="label">Exam fee</span>
            <span class="value">{meta?.fee || record.cost || '—'}</span>
          </div>
          <div class="eg-fact">
            <span class="label">Length</span>
            <span class="value">{meta?.time || '—'}</span>
          </div>
          <div class="eg-fact">
            <span class="label">Pass mark</span>
            <span class="value">{meta?.pass || '—'}</span>
          </div>
        </div>
      ) : (
        <div class="eg-factstrip">
          <div class="eg-fact">
            <span class="label">{mode === 'not-offered' ? 'Status' : 'Issuing agency'}</span>
            <span class="value">
              {mode === 'not-offered' ? 'Not state-licensed' : facts?.agency || dossier?.defaultAgency || exam.body || '—'}
            </span>
          </div>
          <div class="eg-fact">
            <span class="label">Credential type</span>
            <span class="value">{exam.type}</span>
          </div>
          <div class="eg-fact">
            <span class="label">Scope</span>
            <span class="value">{scopeLabel}</span>
          </div>
          {mode === 'researched' && facts?.fee ? (
            <div class="eg-fact">
              <span class="label">State fees</span>
              <span class="value">{facts.fee}</span>
            </div>
          ) : (
            <div class="eg-fact">
              <span class="label">Profession</span>
              <span class="value">{cat?.name}</span>
            </div>
          )}
        </div>
      )}
    </div>
  </header>

  <div class="container two-column-content">
    <aside class="sidebar">
      <SidebarTOC items={tocItems} />
    </aside>

    <main class="main-article">
      {/* Per-exam branded infographic — gives every money page a real,
          crawlable <img> for Google Images + Discover and lifts engagement. */}
      <figure class="eg-infographic">
        <img
          src={`/exams/${exam.slug}/infographic.svg`}
          alt={`${exam.name} — quick facts at a glance: requirements, exam format, fees and timeline`}
          width="760"
          height="600"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{exam.name} — verified snapshot</figcaption>
      </figure>
      {/* ── NATIONAL: quick answer ──────────────────────────── */}
