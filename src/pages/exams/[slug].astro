  .eg-step-note { margin: 0.75rem 0 0; padding: 0.6rem 0.9rem; border-left: 3px solid var(--accent); background: rgba(0, 0, 0, 0.025); border-radius: 0 6px 6px 0; font-size: 0.88rem; line-height: 1.6; color: var(--muted); }

