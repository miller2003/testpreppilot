  .eg-hero h1 { font-family: var(--font-heading); font-weight: 700; font-size: clamp(2.6rem, 5.5vw, 3.8rem); line-height: 1.15; margin: 0 0 1.25rem; }
  .eg-hero .lede { font-size: 1.25rem; color: var(--muted); max-width: 760px; line-height: 1.7; margin: 0; }

  .eg-badges { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.5rem; }
  .eg-badge { font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.4rem 0.8rem; border-radius: 999px; border: 1px solid var(--line); background: var(--paper); color: var(--muted); }
  .eg-badge-ok { border-color: var(--accent-mint, #10b981); color: #0b7a5b; background: #ecfdf5; }
  .eg-badge-compact { border-color: #6366f1; color: #4338ca; background: #eef2ff; }
  .eg-badge-warn { border-color: #f59e0b; color: #92400e; background: #fffbeb; }
  .eg-badge-none { border-color: #94a3b8; color: #475569; background: #f1f5f9; }

  .eg-factstrip { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr)); gap: 1rem; margin-top: 2rem; }
  .eg-fact { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.35rem; transition: transform var(--transition), box-shadow var(--transition); }
  .eg-fact:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .eg-fact .label { display: block; font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .eg-fact .value { display: block; font-family: var(--font-heading); font-size: 1.15rem; font-weight: 600; margin-top: 0.35rem; color: var(--ink); line-height: 1.35; }

  /* Two-column */
  .two-column-content { display: grid; grid-template-columns: clamp(180px, 19vw, 230px) 1fr; gap: clamp(1.5rem, 3.4vw, 3.5rem); padding-top: var(--space-5); padding-bottom: var(--space-section); }
  .sidebar { position: relative; min-width: 0; }

  /* Sections */
  .eg-section { padding: 2.75rem 0; border-top: 1px solid var(--line); }
  .eg-section-cream { background: var(--cream); border-radius: var(--radius-lg); border-top: none; margin: 1.5rem 0; padding: 2.75rem 2.5rem; }
  .eg-kicker { font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--primary); font-weight: 700; margin: 0 0 0.5rem; }
  .eg-section h2 { font-family: var(--font-heading); font-size: clamp(1.8rem, 3vw, 2.4rem); line-height: 1.2; margin: 0 0 1.25rem; }
  .eg-lead { color: var(--muted); line-height: 1.75; margin: 0 0 1.5rem; font-size: 1.05rem; }
  .eg-lead em { color: var(--ink); font-style: italic; }
  .eg-body { color: var(--ink); line-height: 1.8; font-size: 1.05rem; margin: 0 0 1.4rem; }
  .eg-tagline { font-style: italic; font-family: var(--font-heading); font-size: 1.4rem; line-height: 1.4; color: var(--ink); margin: 0 0 1.75rem; }
  .eg-subhead { font-family: var(--font-heading); font-size: 1.15rem; margin: 1.75rem 0 0.85rem; }
  .eg-note { font-size: 0.92rem; color: var(--muted); line-height: 1.6; margin-top: 1rem; }
