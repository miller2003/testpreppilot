  /* ───────── National: registration extras ───────── */
  .eg-step-dur { margin-left: 0.65rem; font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; color: var(--muted); white-space: nowrap; }
  .eg-substeps { list-style: none; padding: 0; margin: 0.7rem 0 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .eg-substeps li { position: relative; padding-left: 1.1rem; font-size: 0.92rem; line-height: 1.6; color: var(--muted); }
