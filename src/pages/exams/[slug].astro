  .eg-splitcards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 1rem; margin-top: 1.25rem; }
  .eg-minicard { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.35rem 1.5rem; }
