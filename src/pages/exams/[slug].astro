  .eg-callout { border-left: 4px solid var(--primary); background: var(--cream); padding: 1.1rem 1.5rem; border-radius: var(--radius); line-height: 1.7; margin: 1.25rem 0; }
  .eg-callout a { color: var(--primary); font-weight: 600; }
  .eg-progress { border-left-color: var(--accent); }
