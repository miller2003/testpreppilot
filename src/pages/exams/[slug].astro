  /* ───────── National: comparison table ───────── */
  .eg-table-compare th[scope='row'] { width: 22%; min-width: 150px; }
  .eg-table-compare thead th { font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .eg-table-compare td { font-size: 0.92rem; line-height: 1.6; }
  .eg-table-footnote { margin: 0.85rem 0 0; font-size: 0.83rem; line-height: 1.65; color: var(--muted); }

  /* ───────── National: bottom line ───────── */
  .eg-summary { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.85rem; }
  .eg-summary li { position: relative; padding-left: 1.8rem; line-height: 1.75; font-size: 1rem; }
  .eg-summary li::before { content: '▪'; position: absolute; left: 0.25rem; top: -0.05rem; color: var(--accent); font-size: 1.1rem; }

  .eg-badge-plain { border-color: var(--line); color: var(--muted); background: var(--paper); }

  @media (max-width: 900px) {
    .two-column-content { grid-template-columns: 1fr; gap: 1rem; }
    .sidebar { display: none; }
    .eg-section-cream { padding: 2rem 1.25rem; }
    .eg-twocol { grid-template-columns: 1fr; }
    .eg-quickblock { padding-left: 1rem; }
    .eg-advantages, .eg-policies { grid-template-columns: 1fr; }
    .eg-topic-head { flex-direction: column; gap: 0.25rem; }
  }

  /* Phone: tighten the long-form reading experience */
  @media (max-width: 640px) {
    .eg-section-cream { padding: 1.5rem 1rem; }
    .eg-factstrip { grid-template-columns: repeat(auto-fit, minmax(min(100%, 130px), 1fr)); gap: 0.75rem; }
    .eg-route li { grid-template-columns: 1fr; gap: 0.6rem; padding: 1.25rem; }
    .eg-essentials .row { padding: 0.85rem 1rem; }
    .eg-summary li { padding-left: 1.4rem; font-size: 0.98rem; }
    /* Long official URLs must not widen the page */
    .eg-sources a { word-break: break-word; }

    /* Step-duration labels use nowrap by default; let them wrap on phones so
       they cannot push the row wider than the viewport. */
    .eg-step-dur { white-space: normal; }
  }
  /* Per-exam infographic figure */
  .eg-infographic { margin: 0 0 2.5rem; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--paper); }
  .eg-infographic img { display: block; width: 100%; height: auto; }
  .eg-infographic figcaption { font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); padding: 0.75rem 1rem; border-top: 1px solid var(--line); }
</style>
