---
import BaseLayout from '../layouts/BaseLayout.astro';

// Contact content (reach the desk + form) has been consolidated into /about.
const target = 'https://testpreppilot.com/about';
---
<BaseLayout
  title="Contact — TestPrepPilot"
  description="Reach the TestPrepPilot Editorial Board — report errors, suggest credentials, or join the review network — now from our About page."
  canonical={target}
>
  <meta http-equiv="refresh" content="0; url=/about#contact" />
  <div class="container" style="max-width:760px;margin:0 auto;padding:6rem 2rem;text-align:center;">
    <h1 style="font-family:var(--font-heading);font-size:2rem;margin-bottom:1rem;">Contact has moved</h1>
    <p style="color:var(--muted);margin-bottom:1.5rem;">
      Reach the Editorial Board from our <a href="/about#contact">About the board</a> page — report an error, suggest a credential, or apply to review.
    </p>
    <a href="/about#contact" class="button">Continue to About</a>
  </div>
</BaseLayout>

<script is:inline>
  window.location.replace('/about#contact');
</script>
