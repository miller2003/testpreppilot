---
interface Props {
  items: { label: string; href: string }[];
}

const { items } = Astro.props;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.label,
    "item": new URL(item.href, Astro.site || 'https://testpreppilot.com').toString()
  }))
};
---
<nav aria-label="Breadcrumb" class="breadcrumb-nav">
  <ol>
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li>
          {isLast ? (
            <span aria-current="page">{item.label}</span>
          ) : (
            <a href={item.href}>{item.label}</a>
          )}
          {!isLast && <span class="separator" aria-hidden="true">/</span>}
        </li>
      );
    })}
  </ol>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData, null, 2)} is:inline />
</nav
