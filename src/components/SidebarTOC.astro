---
/**
 * SidebarTOC — the editorial chapter navigation that sits inside `<aside class="sidebar">`.
 *
 * Designed in the NYT minimal mould:
 *   • eyebrow ("On this page") with hairline rule
 *   • chapter heading (small caps) + bookmark numbering (italic serif)
 *   • indented sub-items with thin vertical guide
 *   • active section = primary blue rail on the left edge
 *   • bounded to viewport height; internal scroll on long chapters
 *   • IntersectionObserver scroll-spy keeps the active link honest
 *
 * The page author passes a flat list of items with optional `sub: true` flags.
 * At render-time we walk the items and split them into chapters based on a
 * `chapterTitle` property carried by the first item in each chapter.
 */

export interface TocItem {
  id: string;
  label: string;
  sub?: boolean;
  /** When set on the first item of a chapter, starts a new chapter with this title. */
  chapterTitle?: string;
}

interface Props {
  items: TocItem[];
  /** Text above the chapters. Default: "On this page". */
  eyebrow?: string;
}

const { items, eyebrow = 'On this page' } = Astro.props;

// Group flat items into chapters keyed by their `chapterTitle` markers.
type Chapter = {
  id: string;
  title: string;
  main: TocItem[];
  sub: TocItem[];
  number: string;
};

const chapters: Chapter[] = [];
let current: Chapter | null = null;

for (const item of items) {
  if (item.chapterTitle) {
    current = { id: item.id, title: item.chapterTitle, main: [], sub: [], number: '' };
    chapters.push(current);
    // The chapter-title marker is also rendered as the chapter's first clickable
    // link: clicking "Career outlook" jumps to #salary, the first item it groups.
    current.main.push(item);
    continue;
  }
  if (!current) {
    current = { id: item.id, title: '', main: [], sub: [], number: '' };
    chapters.push(current);
  }
  if (item.sub) current.sub.push(item);
  else current.main.push(item);
}

// Renumber chapters (01, 02…) globally. Titled chapters get a number; loose
// pre-chapter items share "00" so the numbering of titled chapters stays clean.
const padded = (n: number) => String(n).padStart(2, '0');
let counter = 0;
for (const ch of chapters) {
  ch.number = ch.title ? padded(++counter) : '00';
}
---

<nav class="sbtoc" aria-label="Article sections" data-toc-root>
  <p class="sbtoc-eyebrow">{eyebrow}</p>

  {chapters.map((ch) => (
    ch.title ? (
      <section class="sbtoc-chapter" aria-labelledby={`sbtoc-ch-${ch.id}`}>
        <header class="sbtoc-chapter-head">
          <span class="sbtoc-chapter-num" aria-hidden="true">{ch.number}</span>
          <h4 id={`sbtoc-ch-${ch.id}`} class="sbtoc-chapter-title">{ch.title}</h4>
        </header>
        <ol class="sbtoc-list">
          {ch.main.map((it) => (
            <li class="sbtoc-item">
              <a href={`#${it.id}`} class="sbtoc-link" data-toc-link={it.id}>
                <span class="sbtoc-label">{it.label}</span>
              </a>
            </li>
          ))}
          {ch.sub.length > 0 && (
            <ol class="sbtoc-sublist">
              {ch.sub.map((it) => (
                <li class="sbtoc-item sbtoc-item-sub">
                  <a href={`#${it.id}`} class="sbtoc-link sbtoc-link-sub" data-toc-link={it.id}>
                    <span class="sbtoc-label">{it.label}</span>
                  </a>
                </li>
              ))}
            </ol>
          )}
        </ol>
      </section>
    ) : (
      <ol class="sbtoc-list sbtoc-list-loose">
        {ch.main.map((it) => (
          <li class="sbtoc-item">
            <a href={`#${it.id}`} class="sbtoc-link" data-toc-link={it.id}>
              <span class="sbtoc-label">{it.label}</span>
            </a>
          </li>
        ))}
      </ol>
    )
  ))}
</nav>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-toc-root]');
    if (!root) return;

    // Only hint "more below" when the TOC actually overflows its box.
    const applyOverflowState = () => {
      root.classList.toggle('has-overflow', root.scrollHeight > root.clientHeight + 2);
    };
    applyOverflowState();
    window.addEventListener('resize', applyOverflowState);

    const links = Array.from(root.querySelectorAll('[data-toc-link]'));
    if (!links.length) return;

    const targets = links
      .map((link) => {
        const id = link.getAttribute('data-toc-link');
        const target = id ? document.getElementById(id) : null;
        return target ? { id, target, link } : null;
      })
      .filter(Boolean);

    if (!targets.length) return;

    let activeLink = null;
    const setActive = (link) => {
      if (activeLink === link) return;
      links.forEach((l) => l.classList.remove('is-active'));
      if (link) link.classList.add('is-active');
      activeLink = link;
    };

    // Pick the section whose top has just crossed the "active line" (~33%
    // from the top). If none has, fall back to the last section still on
    // screen so a user above the first heading still gets a sensible
    // anchor highlighted.
    const recompute = () => {
      const line = window.innerHeight * 0.33;
      let best = null;
      let lastVisible = null;
      for (const t of targets) {
        const rect = t.target.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > window.innerHeight) continue;
        lastVisible = t;
        if (rect.top <= line) best = t;
      }
      setActive((best || lastVisible)?.link || null);
    };

    const observer = new IntersectionObserver(() => recompute(), {
      rootMargin: '-10% 0px -55% 0px',
      threshold: [0, 0.25, 0.5, 0.75, 1]
    });
    targets.forEach((t) => observer.observe(t.target));

    let raf = 0;
    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        recompute();
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    recompute();

    // Smooth scroll for in-page anchors (kept consistent with the active link).
    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        const id = link.getAttribute('data-toc-link');
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', `#${id}`);
        setActive(link);
      });
    });
  })();
</script>

<style>
  .sbtoc {
    --sbtoc-num: var(--font-heading);
    --sbtoc-eyebrow: var(--font-mono);

    /* Sticky: this element is a direct child of the stretched grid slot
       (aside.sidebar), which runs the full article height — that parent is
       what gives sticky room to travel down the page. Do NOT wrap it in an
       extra div; a wrapper whose height equals the content kills sticky.
       `position: sticky` also serves as the containing block for ::before. */
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    overscroll-behavior: contain;

    padding-left: 1rem;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  /* Only when the nav actually overflows do we hint it with a bottom fade —
     the eyebrow and first items stay crisp. The class is toggled in JS. */
  .sbtoc.has-overflow {
    mask-image: linear-gradient(to bottom, #000 0, #000 calc(100% - 1.25rem), transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 calc(100% - 1.25rem), transparent 100%);
  }

  /* Thin vertical guide that runs the full TOC height — feeds the eye from
     chapter to chapter and acts as the canvas for the active rail. */
  .sbtoc::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2.4rem;
    bottom: 0.25rem;
    width: 1px;
    background: var(--line);
    opacity: 0.7;
  }

  .sbtoc-eyebrow {
    font-family: var(--sbtoc-eyebrow);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink);
    font-weight: 700;
    margin: 0 0 1.25rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--ink);
    line-height: 1.2;
  }

  .sbtoc-chapter {
    margin-bottom: 1.25rem;
  }
  .sbtoc-chapter:last-child {
    margin-bottom: 0;
  }

  .sbtoc-chapter-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.55rem;
  }

  .sbtoc-chapter-num {
    font-family: var(--sbtoc-num);
    font-style: italic;
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1;
    flex: 0 0 auto;
  }

  .sbtoc-chapter-title {
    font-family: var(--sbtoc-eyebrow);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sbtoc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }
  .sbtoc-list-loose {
    margin: 0 0 1rem;
  }

  .sbtoc-item {
    margin: 0;
    padding: 0;
  }

  .sbtoc-link {
    display: block;
    color: var(--muted);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.87rem;
    line-height: 1.35;
    padding: 0.32rem 0.5rem 0.32rem 0.85rem;
    border-radius: 4px;
    position: relative;
    transition: color 200ms ease, background-color 200ms ease;
  }

  /* Active rail: a 2px blue line flush against the chapter guide rail */
  .sbtoc-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 2px;
    height: 0;
    background: var(--primary);
    border-radius: 2px;
    transition: height 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sbtoc-link:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--primary) 4%, transparent);
  }

  .sbtoc-link.is-active {
    color: var(--ink);
    font-weight: 600;
  }
  .sbtoc-link.is-active::before {
    height: calc(100% - 6px);
  }

  /* Sub-items: indented with their own hairline guide */
  .sbtoc-sublist {
    list-style: none;
    padding: 0.15rem 0 0.15rem 1rem;
    margin: 0.1rem 0 0.25rem;
    border-left: 1px solid var(--line);
    margin-left: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.02rem;
  }

  .sbtoc-link-sub {
    font-size: 0.8rem;
    padding: 0.22rem 0.5rem 0.22rem 0.6rem;
    color: var(--muted);
  }
  .sbtoc-link-sub:hover {
    color: var(--ink);
  }

  /* Dark theme: lift the muted color so links still read */
  :global([data-theme="dark"]) .sbtoc-link {
    color: color-mix(in srgb, var(--muted) 88%, var(--ink));
  }
  :global([data-theme="dark"]) .sbtoc-link:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--primary) 10%, transparent);
  }
  :global([data-theme="dark"]) .sbtoc-chapter-num {
    color: var(--muted);
  }

  /* Keyboard-focus ring in case the rounded background hides the affordance. */
  .sbtoc-link:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Tighten the column on narrow desktop screens where the sidebar compresses */
  @media (max-width: 1180px) {
    .sbtoc-link { font-size: 0.83rem; padding-right: 0.25rem; }
    .sbtoc-link-sub { font-size: 0.76rem; }
  }

  /* Mobile falls back to flat — the parent page already hides the sidebar
     at <=900px, but cover the in-between case where the grid still renders. */
  @media (max-width: 900px) {
    .sbtoc {
      position: static;
      max-height: none;
      overflow: visible;
      mask-image: none;
      -webkit-mask-image: none;
    }
  }
</style>
