---
import { buildDirectory } from '../data/examCatalog/index.mjs';

// Was: src/data/categories.ts mapped to /explore#<id> anchor links — 7 link slots
// per page × 629 pages all pointing at one page's fragment, passing nothing to the
// category hubs. Now points at the real category pages, so footer equity actually
// reaches the 558 exam pages through their topical parent.
const topCategories = buildDirectory()
  .sort((a: any, b: any) => b.total - a.total)
  .slice(0, 8);
---
<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <a href="/" class="brand" aria-label="TestPrepPilot Home">
        TestPrepPilot
      </a>
      <p class="tagline">Guiding your professional journey with verified credential paths.</p>
    </div>

    <div class="footer-links">
      <div class="footer-column">
        <h4>Browse</h4>
        <ul>
          <li><a href="/">All Exams Directory</a></li>
          <li><a href="/states">Browse by State</a></li>
          <li><a href="/explore">Browse by Field</a></li>
        </ul>
      </div>

      <div class="footer-column footer-column--wide">
        <h4>Fields</h4>
        <ul class="field-list">
          {topCategories.map((category: any) => (
            <li><a href={`/categories/${category.id}`}>{category.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-column">
        <h4>Resources</h4>
        <ul>
          <li><a href="/guides">Guides & Resources</a></li>
          <li><a href="/about#reviews">Reader reviews</a></li>
          <li><a href="/about#contact">Reach the desk</a></li>
        </ul>
      </div>

      <div class="footer-column">
        <h4>Company</h4>
        <ul>
          <li><a href="/about">About the desk</a></li>
          <li><a href="/methodology">Methodology</a></li>
          <li><a href="/reviewers">Review Network</a></li>
          <li><a href="/editorial-policy">Editorial Policy</a></li>
          <li><a href="/disclosure">Affiliate Disclosure</a></li>
        </ul>
      </div>

      <div class="footer-column">
        <h4>Support</h4>
        <ul>
          <li><a href="/about#contact">Contact</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} TestPrepPilot. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer-column--wide .field-list { columns: 2; column-gap: 2rem; }
  @media (max-width: 700px) {
    .footer-column--wide .field-list { columns: 1; }
  }
</style>
