---
import { states } from '../data/states';

interface Props {
  excludeSlug?: string;
  heading?: string;
  showHeading?: boolean;
}

const { excludeSlug, heading = "Browse every state", showHeading = true } = Astro.props;

const regionOrder = ['Northeast', 'Midwest', 'South', 'West'];
const byRegion: Record<string, typeof states> = {};
for (const s of states) {
  (byRegion[s.region] ||= []).push(s);
}
const regions = regionOrder
  .filter((r) => byRegion[r])
  .map((r) => ({ name: r, items: byRegion[r].filter((s) => s.slug !== excludeSlug) }));
---

<section class="state-directory" aria-label="Browse professional licenses by U.S. state">
  {showHeading && <h2 class="sd-heading">{heading}</h2>}
  <div class="sd-regions">
    {regions.map((region) => (
      <div class="sd-region">
        <h3 class="sd-region-title">{region.name}</h3>
        <ul class="sd-grid">
          {region.items.map((s) => (
            <li>
              <a href={`/${s.slug}`} class="sd-link">{s.name}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .state-directory { margin: 0 auto; max-width: 1200px; }
  .sd-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1.2;
    margin: 0 0 2rem;
  }
  .sd-regions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 2.5rem 2rem;
  }
  .sd-region-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--primary);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--line);
  }
  .sd-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .sd-link {
    display: block;
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    font-size: 0.98rem;
    border: 1px solid transparent;
    transition: background var(--transition), border-color var(--transition), color var(--transition);
  }
  .sd-link:hover {
    background: var(--primary-light);
    border-color: var(--primary);
    color: var(--primary);
  }
</style>
