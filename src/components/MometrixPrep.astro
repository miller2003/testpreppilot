---
/**
 * MometrixPrep — affiliate study-material block for exams that have a matching
 * Mometrix product (src/data/mometrix.mjs, generated by scripts/mometrix/build.mjs).
 *
 *   variant="full"     the main block: featured product card + other formats,
 *                      caveat note and disclosure. Renders as <section id="prep">.
 *   variant="compact"  a one-line reminder for the end of the page.
 *
 * Renders nothing when the exam has no mapped product, so callers can drop it
 * in unconditionally. Links point at /go/mometrix/<slug>, a Pages Function
 * (functions/go/mometrix/[slug].js). The inline script below stamps a 120s
 * ticket cookie on every trusted click; /go/ redirects straight away when the
 * ticket is there, and otherwise shows a one-tap confirm page instead, so
 * crawlers never reach the Mometrix tracking link. Clicks are also reported
 * to GA4 as `affiliate_click` (and to PostHog by Analytics.astro).
 */
import { mometrixFor } from '../data/mometrix.mjs';

interface Props {
  slug: string;
  examName: string;
  variant?: 'full' | 'compact';
  /** Analytics label for where on the page the block sits. */
  placement: string;
}

const { slug, examName, variant = 'full', placement } = Astro.props;
const match = mometrixFor(slug);
const featured = match?.products[0];
const others = match?.products.slice(1) || [];

const KIND = {
  guide: {
    label: 'Study guide',
    desc: 'Content review with practice questions and answer explanations.',
    cta: 'See the study guide'
  },
  flashcards: {
    label: 'Flashcards',
    desc: 'Quick-recall cards for drilling the facts and terms you need to memorize.',
    cta: 'See the flashcards'
  },
  course: {
    label: 'Online course',
    desc: 'Self-paced online lessons with practice questions.',
    cta: 'See the course'
  }
} as const;

const rel = 'sponsored nofollow noopener';
const track = (p: any) => ({
  'data-mx-product': p.id,
  'data-mx-kind': p.kind,
  'data-mx-exam': slug,
  'data-mx-placement': placement,
  // /go/ links are same-origin: keep Astro's hover prefetch and the
  // ClientRouter away from them, or a hover would count as a click.
  'data-astro-prefetch': 'false',
  'data-astro-reload': true
});
const heading = featured?.kind === 'course'
  ? `Which prep course should you use for the ${examName}?`
  : `Which study guide should you use for the ${examName}?`;
---

{featured && variant === 'full' && (
  <section id="prep" class="mx-section">
    <p class="mx-kicker">Study materials</p>
    <h2 class="mx-h2">{heading}</h2>
    <p class="mx-lead">
      Start with the exam sponsor's official content outline. If you also want one structured resource to
      work through, these are the Mometrix titles that match this exam.
    </p>

    <div class="mx-layout">
      <a class="mx-feature" href={featured.go} target="_blank" rel={rel} {...track(featured)}>
        {featured.img && (
          <span class="mx-cover">
            <img
              src={featured.img}
              alt={`${featured.name} cover`}
              width={featured.imgW || undefined}
              height={featured.imgH || undefined}
              loading="lazy"
              decoding="async"
              onerror="this.parentNode.remove()"
            />
          </span>
        )}
        <span class="mx-body">
          <span class="mx-kind">{KIND[featured.kind].label}</span>
          <span class="mx-name">{featured.name}</span>
          <span class="mx-desc">{KIND[featured.kind].desc}</span>
          <span class="mx-btn">{KIND[featured.kind].cta} <span aria-hidden="true">→</span></span>
        </span>
      </a>

      {others.length > 0 && (
        <div class="mx-others">
          <p class="mx-others-head">Prefer another format?</p>
          <ul class="mx-list">
            {others.map((p) => (
              <li>
                <a class="mx-row" href={p.go} target="_blank" rel={rel} {...track(p)}>
                  <span class="mx-row-text">
                    <span class="mx-kind">{KIND[p.kind].label}</span>
                    <span class="mx-row-name">{p.name}</span>
                    <span class="mx-row-desc">{KIND[p.kind].desc}</span>
                  </span>
                  <span class="mx-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    {match.note && <p class="mx-note">{match.note}</p>}

    <p class="mx-disclosure">
      <span class="mx-tag">Affiliate links</span>
      We may earn a commission if you buy through these links, at no extra cost to you. Mometrix has no say in
      what our exam guides cover. <a href="/disclosure/">How we make money</a>.
    </p>
  </section>
)}

{featured && variant === 'compact' && (
  <aside class="mx-compact" aria-label="Recommended study material">
    <p class="mx-compact-text">
      <span class="mx-kind">{KIND[featured.kind].label}</span>
      <span class="mx-compact-name">Ready to start? {featured.name}</span>
    </p>
    <a class="mx-btn mx-btn-solid" href={featured.go} target="_blank" rel={rel} {...track(featured)}>
      {KIND[featured.kind].cta} <span aria-hidden="true">→</span>
    </a>
    <p class="mx-compact-disc">
      Affiliate link: we may earn a commission. <a href="/disclosure/">Disclosure</a>.
    </p>
  </aside>
)}

<script is:inline>
  // Two jobs, one delegated listener (guarded, because a page can render this
  // component twice). Runs inline so the ticket is armed before anyone can click.
  //
  // 1. Ticket: a trusted click stamps a 120s cookie scoped to /go/. The Pages
  //    Function only redirects when that ticket is present, so a crawler that
  //    merely fetches the URL never reaches Mometrix. We never preventDefault:
  //    the click stays 100% native (new tab, middle-click, Cmd/Ctrl+click).
  // 2. GA4 affiliate_click, unchanged.
  (function () {
    if (window.__mxOutbound) return;
    window.__mxOutbound = true;

    function stamp(a) {
      var href = a.getAttribute('href') || '';
      if (href.indexOf('/go/') !== 0) return;
      var rnd;
      try {
        rnd = Array.prototype.map.call(crypto.getRandomValues(new Uint8Array(6)), function (b) {
          return ('0' + b.toString(16)).slice(-2);
        }).join('');
      } catch (e) {
        rnd = Math.random().toString(16).slice(2, 14);
      }
      try {
        document.cookie = 'mxg=' + Math.floor(Date.now() / 1000) + '.' + rnd +
          ';Path=/go/;Max-Age=120;SameSite=Lax' + (location.protocol === 'https:' ? ';Secure' : '');
      } catch (e) { /* blocked cookies just mean the confirm page */ }
    }

    function handler(e) {
      if (!e.isTrusted) return;
      if (e.type === 'auxclick' && e.button !== 1) return;
      var t = e.target;
      var a = t && t.closest ? t.closest('a[data-mx-product]') : null;
      if (!a) return;
      stamp(a);
      if (typeof window.gtag !== 'function') return;
      var d = a.dataset || {};
      window.gtag('event', 'affiliate_click', {
        program: 'mometrix',
        product_id: d.mxProduct,
        product_kind: d.mxKind,
        exam_slug: d.mxExam,
        placement: d.mxPlacement,
        transport_type: 'beacon'
      });
    }

    // Capture phase: even if another handler stops propagation, the ticket is set.
    document.addEventListener('click', handler, true);
    document.addEventListener('auxclick', handler, true);
  })();
</script>

<style>
  .mx-section { padding: 2.75rem 0; border-top: 1px solid var(--line); }
  .mx-kicker { font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--primary); font-weight: 700; margin: 0 0 0.75rem; }
  .mx-h2 { font-family: var(--font-heading); font-size: clamp(1.8rem, 3vw, 2.4rem); line-height: 1.2; margin: 0 0 1.25rem; }
  .mx-lead { color: var(--muted); line-height: 1.75; margin: 0 0 1.5rem; font-size: 1.05rem; max-width: 70ch; }

  .mx-layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 1rem; align-items: stretch; }
  .mx-layout:has(> :only-child) { grid-template-columns: minmax(0, 1fr); max-width: 640px; }

  .mx-kind { display: inline-block; font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; color: var(--primary); }

  /* Featured card — the whole card is the link */
  .mx-feature {
    display: flex; gap: 1.25rem; align-items: flex-start;
    padding: 1.35rem; border: 1px solid var(--line); border-left: 4px solid var(--primary);
    border-radius: var(--radius); background: var(--paper); color: var(--ink); text-decoration: none;
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .mx-feature:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); }
  .mx-feature:focus-visible, .mx-row:focus-visible, .mx-btn-solid:focus-visible { outline: 3px solid var(--primary); outline-offset: 3px; }
  .mx-cover { flex: 0 0 104px; border-radius: 6px; overflow: hidden; background: var(--cream); box-shadow: var(--shadow-sm); }
  .mx-cover img { display: block; width: 100%; height: auto; }
  .mx-body { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
  .mx-name { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 700; line-height: 1.25; }
  .mx-desc { color: var(--muted); line-height: 1.6; font-size: 0.95rem; }
  .mx-btn {
    display: inline-flex; align-items: center; gap: 0.4rem; align-self: flex-start;
    margin-top: 0.5rem; min-height: var(--tap-min, 44px); padding: 0 1.15rem;
    border-radius: 999px; background: var(--primary); color: #fff; font-weight: 600; font-size: 0.95rem;
    text-decoration: none; white-space: nowrap;
  }

  /* Other formats */
  .mx-others { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; }
  .mx-others-head { margin: 0; font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .mx-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .mx-row {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    min-height: var(--tap-min, 44px); padding: 0.85rem 1.1rem;
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper);
    color: var(--ink); text-decoration: none; transition: border-color var(--transition), transform var(--transition);
  }
  .mx-row:hover { border-color: var(--primary); transform: translateX(3px); }
  .mx-row-text { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .mx-row-name { font-weight: 600; line-height: 1.35; }
  .mx-row-desc { color: var(--muted); font-size: 0.86rem; line-height: 1.5; }
  .mx-arrow { flex: 0 0 auto; color: var(--primary); font-weight: 700; }

  .mx-note { margin: 1.1rem 0 0; padding: 0.75rem 1rem; border-left: 3px solid var(--accent-gold, #f59e0b); background: var(--cream); border-radius: 0 8px 8px 0; font-size: 0.92rem; line-height: 1.6; color: var(--ink); }
  .mx-disclosure { margin: 1rem 0 0; font-size: 0.84rem; line-height: 1.6; color: var(--muted); }
  .mx-disclosure a, .mx-compact-disc a { color: var(--primary); font-weight: 600; }
  .mx-tag { display: inline-block; margin-right: 0.4rem; padding: 0.1rem 0.5rem; border: 1px solid var(--line); border-radius: 999px; font-family: var(--font-mono); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.06em; }

  /* Compact reminder */
  .mx-compact {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem;
    margin: 1.75rem 0 0; padding: 1.1rem 1.35rem;
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--cream);
  }
  .mx-compact-text { margin: 0; flex: 1 1 260px; display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .mx-compact-name { font-weight: 600; line-height: 1.4; }
  .mx-compact .mx-btn { margin-top: 0; }
  .mx-compact-disc { flex: 1 1 100%; margin: 0; font-size: 0.8rem; color: var(--muted); }

  @media (max-width: 900px) {
    .mx-layout { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 480px) {
    .mx-feature { flex-direction: column; }
    .mx-cover { flex-basis: auto; width: 96px; }
    .mx-btn { white-space: normal; }
  }
</style>
