---
import BreadcrumbNav from './BreadcrumbNav.astro';
import ProviderTable from './ProviderTable.astro';
import AffiliateBox from './AffiliateBox.astro';
import FAQAccordion from './FAQAccordion.astro';
import InlineDisclosure from './InlineDisclosure.astro';
import DepthSections from './DepthSections.astro';
import AuthorByline from './AuthorByline.astro';
import SidebarTOC from './SidebarTOC.astro';
import { depthFor, depthSections } from '../data/examCatalog/examDepth.mjs';

interface Props {
  credential: any;
  ex?: any;
  breadcrumbs?: { label: string; href: string }[];
  stateInfo?: any;
  stateData?: any;
}

const { credential, ex, breadcrumbs = [], stateInfo = null, stateData = null } = Astro.props;

// Shared depth layer (the eight P0 sections + named author). State pages keep the
// national credential's depth out of it — the data is exam-specific, not state-specific.
const depth = stateInfo ? null : depthFor(credential.slug);
const depthNav = depthSections(depth);

const isState = !!stateInfo;
const title = credential.name;
const lede = (stateData?.description || credential.description || credential.tagline || '').toString();

// ----- Fact strip -----
const factStrip =
  ex?.factStrip ||
  (credential.facts
    ? credential.facts.map((f: any) => ({ label: f.label, value: f.value }))
    : null) ||
  (stateData
    ? [
        stateData.requiredHours && { label: 'Required Hours', value: stateData.requiredHours },
        stateData.examFee && { label: 'Exam Fee', value: stateData.examFee },
        stateData.licenseFee && { label: 'License Fee', value: stateData.licenseFee },
        stateData.regulatorName && { label: 'Regulator', value: stateData.regulatorName }
      ].filter(Boolean)
    : null);

// ----- Path at a glance -----
const roadmap = (credential.roadmap || []).map((r: string) => {
  const i = r.indexOf('(');
  if (i > 0) return { label: r.slice(0, i).trim(), desc: r.slice(i + 1).replace(/\)$/, '') };
  return { label: r, desc: '' };
});

// ----- FAQ merge (dedupe) -----
const faqItems: { question: string; answer: string }[] = [];
const seen = new Set<string>();
if (ex?.faqs) {
  for (const f of ex.faqs) {
    if (!seen.has(f.q)) { seen.add(f.q); faqItems.push({ question: f.q, answer: f.a }); }
  }
}
if (credential.faq) {
  for (const f of credential.faq) {
    if (!seen.has(f.question)) { seen.add(f.question); faqItems.push({ question: f.question, answer: f.answer }); }
  }
}

// ----- Sidebar TOC (editorial chapters) -----
// Group presence-driven items into NYT-style chapters and roll the eight P0
// depth sections under a single "Preparation" umbrella so the in-page nav
// doesn't grow past ~10 main items even on gold-standard pages.
const tocItems: { id: string; label: string; sub?: boolean; chapterTitle?: string }[] = [];
const pushIf = (cond: any, item: typeof tocItems[number]) => { if (cond) tocItems.push(item); };
const subItem = (id: string, label: string) => ({ id, label, sub: true });

const hasQuickAnswer = !!credential.quickAnswer;
const hasPath = roadmap.length > 0;
const hasExam = !!(ex || credential.examDetails);
const hasProviders = !!credential.providers?.length;
const hasRoute = !!(credential.registrationSteps?.length || credential.steps?.length);
const hasTimeline = !!credential.timeline?.length;
const hasCosts = !!credential.costBreakdown?.items?.length;
const hasFaq = faqItems.length > 0;
const hasSummary = !!credential.summaryPoints?.length;

// 01 — The basics
tocItems.push({ id: 'overview', label: 'Overview', chapterTitle: 'The basics' });
pushIf(hasQuickAnswer, { id: 'quick-answer', label: 'Quick answer' });
pushIf(!!stateInfo, { id: 'state-specific', label: `${stateInfo?.name || 'State'} specifics` });
pushIf(hasPath, { id: 'path', label: 'The path at a glance' });

// 02 — What you need
pushIf(true, { id: 'requirements', label: 'Requirements', chapterTitle: 'What you need' });
pushIf(hasExam, { id: 'exam', label: 'The exam' });

// 03 — Plan & pay
const planItems = [];
planItems.push({ id: 'providers', label: 'Providers' });
pushIf(hasProviders, planItems[planItems.length - 1]);
pushIf(hasRoute, { id: 'route', label: 'Your route', chapterTitle: hasProviders ? undefined : 'Plan & pay' });
pushIf(hasTimeline && !hasRoute, { id: 'timeline', label: 'Timeline' });
pushIf(hasCosts && !(hasProviders || hasRoute || hasTimeline), { id: 'costs', label: 'Costs', chapterTitle: 'Plan & pay' });

// Simpler chapter-title strategy for "Plan & pay"
const hasPlanChapter = hasProviders || hasRoute || hasTimeline || hasCosts;
if (hasPlanChapter) {
  // Re-emit the first plan item with chapterTitle if not already set
  const firstPlan = tocItems.find(it => ['providers', 'route', 'timeline', 'costs'].includes(it.id));
  if (firstPlan && !firstPlan.chapterTitle) {
    firstPlan.chapterTitle = 'Plan & pay';
  } else if (!firstPlan) {
    // Should not happen since hasPlanChapter guarantees one
  }
}

// 04 — Career & preparation (rolls the eight P0 depth sections into one chapter)
if (depthNav.length) {
  tocItems.push({
    id: depthNav[0].id,
    label: 'Master the material',
    chapterTitle: 'Career & prep'
  });
  for (let i = 1; i < depthNav.length; i++) {
    tocItems.push(subItem(depthNav[i].id, depthNav[i].label));
  }
}

// 05 — Reference
tocItems.push({ id: 'faq', label: 'FAQ', chapterTitle: 'Reference' });
pushIf(hasSummary, { id: 'summary', label: 'Summary' });
tocItems.push({ id: 'sources', label: 'Sources' });

const hasTopics = ex?.topics?.length;
const hasParts = ex?.parts?.length;
const hasModules = ex?.modules?.length;

const topProvider = credential.providers?.[0];
const hasAffiliate = topProvider?.affiliateUrl;
---

<header class="eg-hero">
  <div class="container">
    <BreadcrumbNav items={breadcrumbs} />
    <p class="eyebrow">{isState ? `${stateInfo.name} • ${credential.category}` : `${credential.category} • ${credential.type}`}</p>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    <AuthorByline author={depth?.author} lastReviewed={depth?.lastReviewed} placement="hero" />

    {factStrip && factStrip.length > 0 && (
      <div class="eg-factstrip">
        {factStrip.map((f: any) => (
          <div class="eg-fact">
            <span class="label">{f.label}</span>
            <span class="value">{f.value}</span>
          </div>
        ))}
      </div>
    )}
  </div>
</header>

<div class="container two-column-content">
  <aside class="sidebar">
    <SidebarTOC items={tocItems} />
  </aside>

  <main class="main-article">
    {/* OVERVIEW */}
    <section id="overview" class="eg-section">
      <p class="eg-kicker">Is this the right path for you?</p>
      <h2>What does {credential.name} involve?</h2>
      <p class="eg-tagline">{credential.tagline}</p>

      <div class="eg-infogrid">
        {credential.time && <div class="eg-info"><h4>Time</h4><p>{credential.time}</p></div>}
        {credential.cost && <div class="eg-info"><h4>Cost</h4><p>{credential.cost}</p></div>}
        {credential.difficulty && <div class="eg-info"><h4>Difficulty</h4><p>{credential.difficulty}</p></div>}
        {credential.audience && <div class="eg-info"><h4>Best for</h4><p>{credential.audience}</p></div>}
        {credential.salaryRange && <div class="eg-info"><h4>Avg Salary</h4><p>{credential.salaryRange}</p></div>}
      </div>

      {credential.prerequisites && (
        <div class="eg-callout">
          <strong>Prerequisites.</strong> {credential.prerequisites}
        </div>
      )}
    </section>

    {/* QUICK ANSWER */}
    {credential.quickAnswer && (
      <section id="quick-answer" class="eg-section">
        <p class="eg-kicker">TL;DR</p>
        <h2>What is {credential.name}, in brief?</h2>
        <div class="eg-quick">
          <p>{credential.quickAnswer.summary}</p>
          {credential.quickAnswer.advantages?.length > 0 && (
            <ul class="eg-advantages">
              {credential.quickAnswer.advantages.map((adv: string) => <li>{adv}</li>)}
            </ul>
          )}
        </div>
      </section>
    )}

    {/* THE PATH AT A GLANCE */}
    {roadmap.length > 0 && (
      <section id="path" class="eg-section eg-section-cream">
        <p class="eg-kicker">The journey</p>
        <h2>What is the path to {credential.name}?</h2>
        <p class="eg-lead">You can't skip ahead — each phase unlocks the next. Here's the full route, end to end.</p>
        <div class="eg-path">
          {roadmap.map((step: any, i: number) => (
            <div class="eg-step">
              <div class="eg-step-num">{i + 1}</div>
              <div class="eg-step-body">
                <span class="eg-step-label">{step.label}</span>
                {step.desc && <span class="eg-step-desc">{step.desc}</span>}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* REQUIREMENTS */}
    <section id="requirements" class="eg-section">
      <p class="eg-kicker">Before you start</p>
      <h2>What are the eligibility requirements for {credential.name}?</h2>
      {isState && stateData?.additionalRequirements?.length > 0 && (
        <div class="eg-callout">
          <strong>Note for {stateInfo.name}.</strong> Requirements may differ from national averages — complete education with a state-approved provider.
          <ul class="eg-reqlist">
            {stateData.additionalRequirements.map((req: string) => <li>{req}</li>)}
          </ul>
        </div>
      )}
      {credential.comparison && (
        <div class="eg-tablewrap">
          <table class="eg-table">
            <thead>
              <tr>
                {credential.comparison.columns.map((col: string) => <th>{col}</th>)}
              </tr>
            </thead>
            <tbody>
              {credential.comparison.rows.map((row: any) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {row.values.map((v: string) => <td>{v}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    {/* THE EXAM IN DETAIL */}
    {(ex || credential.examDetails) && (
      <section id="exam" class="eg-section eg-section-cream">
        <p class="eg-kicker">Inside the test</p>
        <h2>What is the format of the {credential.name} exam?</h2>

        {ex?.examMeta && (
          <div class="eg-meta">
            <div class="eg-meta-item"><span class="k">Questions</span><span class="v">{ex.examMeta.questions}</span></div>
            <div class="eg-meta-item"><span class="k">Time limit</span><span class="v">{ex.examMeta.time}</span></div>
            <div class="eg-meta-item"><span class="k">Pass mark</span><span class="v">{ex.examMeta.pass}</span></div>
            <div class="eg-meta-item"><span class="k">Exam fee</span><span class="v">{ex.examMeta.fee}</span></div>
            <div class="eg-meta-item"><span class="k">Format</span><span class="v">{ex.examMeta.format}</span></div>
            <div class="eg-meta-item"><span class="k">Administered by</span><span class="v">{ex.examMeta.admin}</span></div>
          </div>
        )}

        {ex?.examTopicsTitle && <h3 class="eg-subhead">{ex.examTopicsTitle}</h3>}
        {ex?.examTopicsIntro && <p class="eg-lead">{ex.examTopicsIntro}</p>}

        {hasTopics && (
          <div class="eg-topics">
            {ex.topics.map((t: any) => (
              <div class="eg-topic">
                <span class="eg-topic-weight">{t.weight}</span>
                <span class="eg-topic-name">{t.name}</span>
                {t.note && <span class="eg-topic-note">{t.note}</span>}
              </div>
            ))}
          </div>
        )}

        {hasParts && ex.parts.map((p: any) => (
          <div class="eg-part">
            <h4>{p.name}</h4>
            <ul class="eg-partlist">
              {p.items.map((it: string) => <li>{it}</li>)}
            </ul>
          </div>
        ))}

        {hasModules && (
          <div class="eg-modules">
            {ex.modules.map((m: string) => <span class="eg-module">{m}</span>)}
          </div>
        )}

        {ex?.examEssentials?.length > 0 && (
          <div class="eg-essentials">
            {ex.examEssentials.map((row: any) => (
              <div class="row"><span class="k">{row[0]}</span><span class="v">{row[1]}</span></div>
            ))}
          </div>
        )}
      </section>
    )}

    {/* DEEP-DIVE SECTIONS (shared depth layer: salary, pass rates, study plan,
        strategies, resources, mistakes, question types, exam day) */}
    {depth && <DepthSections depth={depth} variant="eg" />}

    {/* PROVIDERS */}
    {credential.providers?.length > 0 && (
      <section id="providers" class="eg-section">
        <p class="eg-kicker">Choose your school</p>
        <h2>Which prep providers are approved for {credential.name}?</h2>
        <InlineDisclosure />

        {hasAffiliate && topProvider && (
          <div class="eg-affiliate">
            <AffiliateBox provider={topProvider} credentialName={title} />
          </div>
        )}

        <ProviderTable providers={credential.providers} />
      </section>
    )}

    {/* ROUTE */}
    {((credential.registrationSteps?.length || credential.steps?.length)) > 0 && (
      <section id="route" class="eg-section eg-section-cream">
        <p class="eg-kicker">Step by step</p>
        <h2>How do you earn {credential.name}, step by step?</h2>
        {credential.registrationSteps?.length > 0 ? (
          <ol class="eg-route">
            {credential.registrationSteps.map((step: any, index: number) => (
              <li>
                <div class="eg-route-num">{index + 1}</div>
                <div class="eg-route-body">
                  <h3>{step.title}</h3>
                  {step.description && <p>{step.description}</p>}
                  {step.subSteps?.length > 0 && (
                    <ul class="eg-substeps">
                      {step.subSteps.map((s: string) => <li>{s}</li>)}
                    </ul>
                  )}
                  <div class="eg-route-meta">
                    {step.duration && <span class="eg-pill">⏱ {step.duration}</span>}
                    {step.note && <span class="eg-note">Note: {step.note}</span>}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        ) : (
          <ol class="eg-route">
            {credential.steps.map((step: string, index: number) => (
              <li>
                <div class="eg-route-num">{index + 1}</div>
                <div class="eg-route-body">
                  <h3>Step {index + 1}</h3>
                  <p>{step}</p>
                </div>
              </li>
            ))}
          </ol>
        )}
      </section>
    )}

    {/* TIMELINE */}
    {credential.timeline?.length > 0 && (
      <section id="timeline" class="eg-section">
        <p class="eg-kicker">How long</p>
        <h2>How long does it take to get {credential.name}?</h2>
        <div class="eg-tablewrap">
          <table class="eg-table">
            <thead><tr><th>Stage</th><th>Typical Duration</th></tr></thead>
            <tbody>
              {credential.timeline.map((row: any) => (
                <tr><td>{row.stage}</td><td class="eg-duration">{row.duration}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {/* COSTS */}
    {credential.costBreakdown?.items?.length > 0 && (
      <section id="costs" class="eg-section eg-section-cream">
        <p class="eg-kicker">The bill</p>
        <h2>How much does {credential.name} cost?</h2>
        <div class="eg-tablewrap">
          <table class="eg-table">
            <thead><tr><th>Item</th><th>Fee</th></tr></thead>
            <tbody>
              {credential.costBreakdown.items.map((item: any) => (
                <tr><td>{item.item}</td><td class="eg-fee">{item.fee}</td></tr>
              ))}
              <tr class="eg-total"><td>Total</td><td class="eg-fee">{credential.costBreakdown.total}</td></tr>
            </tbody>
          </table>
        </div>
        {credential.costBreakdown.footnote && <p class="eg-footnote">{credential.costBreakdown.footnote}</p>}
      </section>
    )}

    {/* FAQ */}
    {faqItems.length > 0 && (
      <section id="faq" class="eg-section">
        <p class="eg-kicker">Good to know</p>
        <h2>Frequently asked questions about {credential.name}</h2>
        <FAQAccordion items={faqItems} />
      </section>
    )}

    {/* SUMMARY */}
    {credential.summaryPoints?.length > 0 && (
      <section id="summary" class="eg-section">
        <p class="eg-kicker">In short</p>
        <h2>Is {credential.name} worth it?</h2>
        <div class="eg-summary">
          <ul>
            {credential.summaryPoints.map((point: string) => <li>{point}</li>)}
          </ul>
        </div>
        {topProvider?.affiliateUrl && (
          <div class="eg-cta">
            <h3>Ready to start your {credential.shortName || credential.name}?</h3>
            <a href={topProvider.affiliateUrl} class="button" target="_blank" rel="noopener noreferrer">Start with {topProvider.name}</a>
          </div>
        )}
      </section>
    )}

    {/* SOURCES */}
    <section id="sources" class="eg-section eg-section-cream">
      <p class="eg-kicker">Trust</p>
      <h2>Where does this information come from?</h2>
      <p class="eg-lead">We believe in showing our work. The information on this page was sourced from official requirements.</p>
      {credential.sourceUrl && (
        <a href={credential.sourceUrl} target="_blank" rel="noopener noreferrer" class="eg-sourcelink">View official requirements source &rarr;</a>
      )}
      <p class="eg-reviewed">Last reviewed: {depth?.lastReviewed || credential.reviewed || 'Recently'}</p>
      <AuthorByline
        author={depth?.author}
        reviewedBy={depth?.reviewedBy}
        lastReviewed={depth?.lastReviewed}
        placement="footer"
      />
    </section>
  </main>
</div>

<style is:global>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }

  /* Hero */
  .eg-hero { padding: 3rem 0 1.25rem; border-bottom: 1px solid var(--line); }
  .eg-hero .eyebrow { color: var(--primary); font-family: var(--font-mono); font-size: 0.85rem; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 1rem; }
  .eg-hero h1 { font-family: var(--font-heading); font-weight: 700; font-size: clamp(2.6rem, 5.5vw, 3.8rem); line-height: 1.15; margin: 0 0 1.25rem; }
  .eg-hero .lede { font-size: 1.25rem; color: var(--muted); max-width: 760px; line-height: 1.7; margin: 0; }

  .eg-factstrip { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-top: 2rem; }
  .eg-fact { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.35rem; transition: transform var(--transition), box-shadow var(--transition); }
  .eg-fact:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .eg-fact .label { display: block; font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .eg-fact .value { display: block; font-family: var(--font-heading); font-size: 1.45rem; font-weight: 600; margin-top: 0.35rem; color: var(--ink); }

  /* Two-column layout */
  .two-column-content { display: grid; grid-template-columns: clamp(180px, 19vw, 230px) 1fr; gap: clamp(1.5rem, 3.4vw, 3.5rem); padding-top: var(--space-5); padding-bottom: var(--space-section); }
  .sidebar { position: relative; min-width: 0; }

  /* Sections */
  .eg-section { padding: 2.75rem 0; border-top: 1px solid var(--line); }
  .eg-section-cream { background: var(--cream); border-radius: var(--radius-lg); border-top: none; margin: 1.5rem 0; padding: 2.75rem 2.5rem; }
  .eg-kicker { font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--primary); font-weight: 700; margin: 0 0 0.5rem; }
  .eg-section h2 { font-family: var(--font-heading); font-size: clamp(1.8rem, 3vw, 2.4rem); line-height: 1.2; margin: 0 0 1.25rem; }
  .eg-lead { color: var(--muted); line-height: 1.75; margin: 0 0 1.5rem; font-size: 1.05rem; }
  .eg-tagline { font-style: italic; font-family: var(--font-heading); font-size: 1.4rem; line-height: 1.4; color: var(--ink); margin: 0 0 1.75rem; }

  .eg-infogrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1.75rem; }
  .eg-info { background: var(--cream); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.3rem; }
  .eg-info h4 { font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin: 0 0 0.4rem; }
  .eg-info p { margin: 0; font-weight: 600; font-size: 1.05rem; }

  .eg-callout { border-left: 4px solid var(--primary); background: var(--cream); padding: 1.1rem 1.5rem; border-radius: var(--radius); line-height: 1.6; }
  .eg-reqlist { margin: 0.75rem 0 0 1.1rem; display: flex; flex-direction: column; gap: 0.35rem; color: var(--muted); }

  .eg-quick { background: var(--primary-light); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 2rem 2.25rem; }
  .eg-quick p { font-size: 1.15rem; line-height: 1.6; margin: 0 0 1.25rem; }
  .eg-advantages { margin: 0; padding-left: 1.2rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 0.6rem 1.5rem; }
  .eg-advantages li { line-height: 1.5; }

  /* Path flow */
  .eg-path { display: flex; flex-wrap: wrap; gap: 1rem; margin: 1.5rem 0 0.5rem; }
  .eg-step { flex: 1 1 240px; display: flex; align-items: flex-start; gap: 1.25rem; position: relative; padding: 1rem 1.5rem 1rem 0; }
  .eg-step-num { width: 44px; height: 44px; flex: 0 0 auto; border-radius: 50%; background: var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-weight: 600; font-size: 1.1rem; box-shadow: var(--shadow-sm); position: relative; z-index: 1; }
  .eg-step:last-child .eg-step-num { background: var(--ink); }
  .eg-step-body { display: flex; flex-direction: column; gap: 0.2rem; padding-top: 0.4rem; }
  .eg-step-label { font-weight: 600; font-family: var(--font-heading); font-size: 1.02rem; line-height: 1.35; }
  .eg-step-desc { color: var(--muted); font-size: 0.92rem; line-height: 1.45; }

  /* Exam meta */
  .eg-meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.85rem; margin: 0 0 2rem; }
  .eg-meta-item { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 0.9rem 1.1rem; }
  .eg-meta-item .k { display: block; font-family: var(--font-mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--primary); font-weight: 700; }
  .eg-meta-item .v { display: block; font-weight: 600; margin-top: 0.3rem; font-size: 0.98rem; }

  .eg-subhead { font-family: var(--font-heading); font-size: 1.35rem; margin: 1.5rem 0 0.5rem; }
