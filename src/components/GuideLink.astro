---
/**
 * GuideLink — "read the bigger picture" pointer from an exam page to the
 * editorial guide(s) that list this exam in `examSlugs` (src/data/guides.ts).
 * Renders nothing when no guide claims the exam, so callers can drop it in
 * unconditionally.
 */
import { guidesForExam } from '../data/guides';

interface Props {
  slug: string;
}

const guides = guidesForExam(Astro.props.slug);
---

{guides.length > 0 && (
  <aside class="gl" aria-label="Related guide">
    <p class="gl-kicker">The bigger picture</p>
    <ul class="gl-list">
      {guides.map((g) => (
        <li>
          <a class="gl-link" href={`/guides/${g.slug}/`}>
            <span class="gl-title">{g.title}</span>
            <span class="gl-desc">{g.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .gl { margin: 2rem 0; padding: 1.15rem 1.35rem; border: 1px solid var(--line); border-left: 4px solid var(--primary); border-radius: var(--radius); background: var(--cream); }
  .gl-kicker { margin: 0 0 0.6rem; font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--primary); font-weight: 700; }
  .gl-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.85rem; }
  .gl-link { display: flex; flex-direction: column; gap: 0.25rem; min-height: var(--tap-min, 44px); color: var(--ink); text-decoration: none; }
  .gl-title { font-family: var(--font-heading); font-weight: 700; font-size: 1.12rem; line-height: 1.3; color: var(--primary); }
  .gl-link:hover .gl-title { text-decoration: underline; text-underline-offset: 3px; }
  .gl-desc { color: var(--muted); font-size: 0.93rem; line-height: 1.55; }
</style>
