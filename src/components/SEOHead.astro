---
import { canonicalForm } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogTitle?: string;
  noindex?: boolean;
  ogType?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogTitle,
  noindex = false,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
} = Astro.props;
const siteUrl = Astro.site || 'https://testpreppilot.com';

// ── Canonical form: the URL that returns 200 in ONE hop ─────────────────
// Directory indexes mean the host serves /about/ and 308-redirects /about. A
// canonical that points at a redirect is ignored, so canonical, og:url and the
// schema @id all read from the same helper — see src/lib/url.ts.
const currentUrl = canonicalForm(Astro.url.pathname, siteUrl);

const finalCanonical = canonicalForm(canonical || currentUrl, siteUrl);
const finalOgTitle = ogTitle || title;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
{description && <meta name="description" content={description} />}
<meta name="theme-color" content="#f8f7f3" />
<link rel="canonical" href={finalCanonical} />
{/* max-snippet:-1 / max-image-preview:large are the two directives that decide
    whether Google (and, by extension, AI Overviews) may quote the page at
    length. Without them the default snippet cap truncates exactly the
    number-dense first paragraphs an AI answer needs to lift. */}
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
<meta name="googlebot" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large"} />

{/* Fonts: preconnect + stylesheet link, discovered by the preload scanner.
    Previously an @import inside the site CSS, which serialised the request
    chain behind a 23 KB render-blocking file — one wasted round-trip on every
    page, with no connection warm-up for the font host. The italic axis is cut
    to 400 (the only italic weight the design uses); 500/600/700 upright are
    retained because the type scale depends on them. */}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
/>

<meta property="og:site_name" content="TestPrepPilot" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={finalOgTitle} />
{description && <meta property="og:description" content={description} />}
{ogImage && <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />}
<meta property="og:type" content={ogType} />
{ogType === 'article' && articlePublishedTime && (
  <meta property="article:published_time" content={articlePublishedTime} />
)}
{ogType === 'article' && articleModifiedTime && (
  <meta property="article:modified_time" content={articleModifiedTime} />
)}
<meta property="og:url" content={currentUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={finalOgTitle} />
{description && <meta name="twitter:description" content={description} />}
{ogImage && <meta name="twitter:image" content={new URL(ogImage, siteUrl).toString()} />}

<title>{title}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
