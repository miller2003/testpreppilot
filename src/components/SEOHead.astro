---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogTitle?: string;
}

const { title, description, canonical, ogImage, ogTitle } = Astro.props;
const siteUrl = Astro.site || 'https://testpreppilot.com';
const currentUrl = new URL(Astro.url.pathname, siteUrl).toString();

const finalOgTitle = ogTitle || title;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
{description && <meta name="description" content={description} />}
<meta name="theme-color" content="#f8f7f3" />
{canonical && <link rel="canonical" href={canonical} />}

<meta property="og:title" content={finalOgTitle} />
{description && <meta property="og:description" content={description} />}
{ogImage && <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />}
<meta property="og:type" content="website" />
<meta property="og:url" content={currentUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={finalOgTitle} />
{description && <meta name="twitter:description" content={description} />}

<title>{title}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
