---
import { relatedExams } from '../lib/relatedExams.mjs';

interface Props {
  exam: any;
  perBucket?: number;
}

const { exam, perBucket = 6 } = Astro.props;
const { groups, category } = relatedExams(exam, { perBucket });
---

{groups.length > 0 && (
  <section class="related-exams" aria-labelledby="related-exams-heading">
    <div class="re-inner">
      <h2 id="related-exams-heading">Related credentials</h2>

      {groups.map((g: any) => (
        <div class="re-block">
          <h3>{g.title}</h3>
          {g.hint && <p class="re-hint">{g.hint}</p>}
          <ul class="re-list">
            {g.exams.map((e: any) => (
              <li>
                <a href={e.href}>
                  <span class="re-name">{e.name}</span>
                  {e.stateCode && <span class="re-tag">{e.stateCode}</span>}
                  {!e.stateCode && <span class="re-tag re-tag--nat">National</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      {category && (
        <p class="re-all">
          <a href={`/categories/${category.id}`}>Browse all {category.name} credentials →</a>
        </p>
      )}
    </div>
  </section>
)}

<style>
  .related-exams {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    padding: 2.5rem 0 3rem;
  }
  .re-inner { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
  .related-exams h2 { font-size: 1.6rem; margin: 0 0 1.5rem; }
  .re-block { margin-bottom: 2rem; }
  .re-block h3 { font-size: 1.05rem; margin: 0 0 0.25rem; }
  .re-hint { margin: 0 0 0.85rem; font-size: 0.9rem; opacity: 0.7; max-width: 68ch; }
  .re-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  .re-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0.85rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1.35;
  }
  .re-list a:hover { border-color: currentColor; }
  .re-name { flex: 1; }
  .re-tag {
    flex: none;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.07);
  }
  .re-tag--nat { font-weight: 600; letter-spacing: 0.02em; }
  .re-all { margin: 0.5rem 0 0; font-size: 0.95rem; }
</style>
