---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import Analytics from '../components/Analytics.astro';
import WebMCP from '../components/WebMCP.astro';
import { organizationSchema, editorialBoardNode } from '../data/editorial';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: object;
  noindex?: boolean;
  dateModified?: string;
  datePublished?: string;
  ogType?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  schema,
  noindex,
  dateModified,
  datePublished,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
} = Astro.props;

// Page-level dates are emitted ONLY when the page supplies a real one.
//
// The previous baseline was a hardcoded site stamp ('2026-08-06') applied to
// every page that did not pass a date — which meant /privacy, /methodology,
// /guides and a dozen others each asserted a dateModified they had no evidence
// for. A self-consistent but false freshness signal is worse than none: it
// teaches crawlers to discount the field on the pages where it IS accurate.
// Omitting the property is valid schema.org and is the honest answer.
const siteUrl = Astro.site || 'https://testpreppilot.com';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const finalOgImage = ogImage || '/og-image.png';

// Either prop name is accepted: exam pages pass datePublished/dateModified,
// the long-form /guides pages pass articlePublishedTime/articleModifiedTime.
// They describe the same two facts, so they resolve to one pair here and both
// the meta tags and the WebPage node read from it — no way to disagree.
const finalDatePublished = datePublished || articlePublishedTime;
const finalDateModified = dateModified || articleModifiedTime;

const defaultSchema = organizationSchema();

const schemaData = schema || defaultSchema;

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://testpreppilot.com/#website",
  "url": "https://testpreppilot.com",
  "name": "TestPrepPilot",
  "publisher": { "@id": "https://testpreppilot.com/#organization" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://testpreppilot.com/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  "url": pageUrl,
  "name": title,
  "isPartOf": { "@id": "https://testpreppilot.com/#website" },
  "inLanguage": "en-US",
  "author": { "@id": "https://testpreppilot.com/#editorial-board" },
  "publisher": { "@id": "https://testpreppilot.com/#organization" },
  ...(finalDatePublished ? { "datePublished": finalDatePublished } : {}),
  ...(finalDateModified ? { "dateModified": finalDateModified } : {})
};

// The Editorial Board is the named author entity for E-E-A-T — a real,
// verifiable team rather than an invented individual. Its node (an
// Organization) is emitted on every page; individual licensed reviewers are
// attached per-guide once real people have been recruited.
const editorialBoardSchema = editorialBoardNode();
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={finalOgImage}
      noindex={noindex}
      ogType={ogType}
      articlePublishedTime={finalDatePublished}
      articleModifiedTime={finalDateModified}
    />
    <Analytics />
    <link rel="alternate" type="application/rss+xml" title="TestPrepPilot" href="/rss.xml" />
    {/* ── Agent discovery, advertised from every page ──────────────────
        These mirror the RFC 8288 Link response headers in public/_headers.
        Both are declared because a client may only surface one of them, and
        every one of these targets must resolve (verified post-build). */}
    <link rel="ai-catalog" type="application/ai-catalog+json" href="/.well-known/ai-catalog.json" />
    <link rel="service-desc" type="application/openapi+json" href="/.well-known/openapi.json" />
    <link rel="service-doc" type="text/plain" href="/llms.txt" />
    <link rel="alternate" type="application/json" title="Published exam catalogue" href="/data/exam-catalog.json" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaData, null, 2)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(editorialBoardSchema)} is:inline />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Resolve theme before first paint so dark-mode users never see a
        white flash, and keep the mobile browser chrome in sync. */}
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        else document.documentElement.removeAttribute('data-theme');
        try { localStorage.setItem('theme', theme); } catch (e) {}

        window.__syncThemeColor = function () {
          var dark = document.documentElement.getAttribute('data-theme') === 'dark';
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#0b0c0d' : '#f8f7f3');
        };
        if (document.readyState !== 'loading') window.__syncThemeColor();
        else document.addEventListener('DOMContentLoaded', window.__syncThemeColor);
        document.addEventListener('astro:after-swap', function () {
          var t = localStorage.getItem('theme');
          if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
          else document.documentElement.removeAttribute('data-theme');
          window.__syncThemeColor();
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body data-pagefind-ignore={noindex ? '' : undefined}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WebMCP />
    
    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        });
        document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
      });
    </script>
  </body>
</html>
