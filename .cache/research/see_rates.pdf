<script>
document.addEventListener("DOMContentLoaded", function () {
    setTimeout(function () {
        document.querySelectorAll(".dealay").forEach(function (el) {
            el.style.opacity = 1;
        });
    }, 800);

    setTimeout(function () {
        document.querySelectorAll(".dealay-low").forEach(function (el) {
            el.style.opacity = 1;
        });
    }, 1500);

    setTimeout(function () {
        document.querySelectorAll(".dealay-lowest").forEach(function (el) {
            el.style.opacity = 1;
        });
    }, 2000);
});

</script>
<script>
function replaceAllLinksWithCountryCode() {
    const countrySpecificUrl = "https://www.prometric.com/"; 
    // Get all anchor tags within the specified section
    const links = document.querySelectorAll('section a');
    // Loop through each link and update the href attribute
    links.forEach(link => {
        const href = link.getAttribute('href');
        // Skip links if:
        // 1. They are inside elements with certain classes
        if (link.closest('.breadcrumb') || link.closest('.text-lightNavy')) {return;}
        // 2. The URL contains '/files/'
        if (href && href.includes('/files/')) {return;}
         // 3. The URL already starts with countrySpecificUrl
        if (href && href.startsWith(countrySpecificUrl)) {return;}
        // Update only links starting with 'https://prod.prometric.com/' but not yet customized
        if (href && href.startsWith('https://www.prometric.com/')) {
            const updatedHref = href.replace('https://www.prometric.com/', countrySpecificUrl);
            link.setAttribute('href', updatedHref); // Update the href attribute
        }
    });
}
// Run the function to replace all links
replaceAllLinksWithCountryCode();
</script>

<!--Back to Top-->
<script>
    const btn = document.getElementById("scrollTopBtn");
    window.onscroll = function () {
      if (document.body.scrollTop > 605 || document.documentElement.scrollTop > 605) {
        btn.style.display = "flex";
      } else {
        btn.style.display = "none";
      }
    };

    btn.onclick = function () {
      window.scrollTo({ top: 0, behavior: "smooth" });
    };
  </script>
