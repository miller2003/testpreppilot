# Copy this file to .env and fill in real values, then rebuild (`npm run build`).
# Until these are set, the site ships with zero third-party analytics requests.

# GA4 measurement ID — GA4 Admin -> Data streams -> your web stream -> "G-..."
PUBLIC_GA4_ID=

# Google Search Console ownership verification (HTML tag method).
# GSC -> Settings -> Ownership verification -> HTML tag -> copy ONLY the
# content="..." token (not the whole <meta> tag).
PUBLIC_GSC_VERIFICATION=

# Vercel: also add both as Environment Variables (Production + Preview) in the
# dashboard, because static builds read env at build time, not runtime.
